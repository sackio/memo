#!/usr/bin/env python3
"""memo-migrate-verify — post-migration checks. [001/FR-039]

Separate script per contracts/migration-cli.md. Exits NON-ZERO on any failed
check: a migration that half-worked and reported success is worse than one that
failed loudly, because the flip to v2 would then happen on a corpus nobody
re-examined.
"""
from __future__ import annotations

import argparse
import asyncio
import json
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parents[1] / "src"))

from memo.migrate import verify  # noqa: E402


async def main() -> int:
    ap = argparse.ArgumentParser(description=__doc__)
    ap.add_argument("--v1-ids-file", default=None,
                    help="file of v1 ids (one per line) to assert resolvability")
    args = ap.parse_args()

    v1_ids = None
    if args.v1_ids_file:
        v1_ids = [ln.strip() for ln in Path(args.v1_ids_file).read_text().splitlines()
                  if ln.strip()]

    result = await verify.verify(v1_ids)
    print(json.dumps(result, indent=2, default=str))
    for c in result["checks"]:
        if not c["passed"]:
            print(f"FAILED CHECK: {c['name']} — {c['detail']}", file=sys.stderr)
    return int(result["exit_code"])


if __name__ == "__main__":
    raise SystemExit(asyncio.run(main()))
