#!/usr/bin/env python3
"""memo-sync-from-v1 — bring v2's corpus to parity with v1, PRESERVING ids.

⭐ **WHY IDS MUST BE PRESERVED, AND WHY THE API CANNOT DO THIS.** Every
cross-build comparison in `bench/` matches documents by id. v2's `POST /documents`
mints a new uuid and offers no way to supply one, so an API-based sync would
produce a corpus that is *content*-identical and *id*-disjoint — and every
benchmark would silently score 0 while looking like a catastrophic retrieval
regression. That is the same shape as v1's 404s reading as rank-1 = 0.
⇒ This writes to the DB directly. v2 is not live (Ben, 2026-08-03: *"there is
nothing lost by modifying version 2"*); doing this to v1 would be unacceptable.

⛔ **ACCOUNTING IS DISCRIMINATED, because a partial sync that reports success is
the failure mode this project already shipped once** (the 2026-07-31 backfill:
3,489 of 7,657 memos failed and the run exited 0, having folded every exception
into `skipped`, which also counted deliberate no-ops):

  - `synced`   — document row AND embedding both written
  - `present`  — already in v2, deliberately untouched. NOT an error.
  - `empty`    — no content to embed. NOT an error, and NOT a silent skip.
  - `failed`   — tried and could not. **Counted separately and listed.**

⚠️ **This syncs v1 → v2 ONLY.** 88 documents exist in v2 and not v1; they are left
alone and are NOT evidence of anything until someone looks at them. Reporting
"parity" while a one-way sync ran is a claim the run cannot support.

⚠️ Documents are inserted WITHOUT passages. Run `memo-index-corpus` afterwards —
it is resumable and picks up exactly the memos lacking a passage index. Until
then the passage path covers a strict subset of the corpus, which
`memo-retrieval-bench --both-indexed-only` already accounts for.
"""
from __future__ import annotations

import argparse
import asyncio
import json
import sys
import time
import urllib.request
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parents[1] / "src"))
sys.path.insert(0, "/app/src")

from memo import db, embeddings  # noqa: E402
from memo.config import settings  # noqa: E402


def fetch(url: str) -> list[dict]:
    with urllib.request.urlopen(url.rstrip("/") + "/documents?limit=20000",
                                timeout=180) as r:
        return json.loads(r.read())


async def main() -> int:
    ap = argparse.ArgumentParser(description=__doc__,
                                 formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("--source", default="http://server4:8000")
    ap.add_argument("--batch", type=int, default=32)
    ap.add_argument("--limit", type=int, default=None)
    ap.add_argument("--dry-run", action="store_true")
    ap.add_argument("--progress-every", type=int, default=100)
    args = ap.parse_args()

    print(f"target config: {settings.embedding_model} @ "
          f"{settings.embedding_dimensions}", flush=True)
    src = fetch(args.source)
    conn = db._get_or_create_conn(db._resolve_path(None))
    have = {r[0] for r in conn.execute("SELECT id FROM documents")}
    missing = [d for d in src if d["id"] not in have]
    extra = len(have) - len(set(have) & {d["id"] for d in src})
    print(f"source {len(src)} · target {len(have)} · missing here {len(missing)} "
          f"· present only here {extra} (left alone)", flush=True)
    if args.limit:
        missing = missing[:args.limit]
    if args.dry_run:
        print("DRY RUN — nothing written")
        return 0

    stats = {"synced": 0, "present": 0, "empty": 0, "failed": 0}
    failures: list[str] = []
    started = time.time()

    for i in range(0, len(missing), args.batch):
        chunk = missing[i:i + args.batch]
        live = [d for d in chunk if (d.get("content") or "").strip()]
        stats["empty"] += len(chunk) - len(live)
        if not live:
            continue
        try:
            vecs = await embeddings.embed_batch([d["content"] for d in live])
            if len(vecs) != len(live):
                raise ValueError(f"provider returned {len(vecs)} for {len(live)}")
        except Exception:
            # ISOLATE rather than abandon: one over-length input fails the whole
            # request, so a batch-level abort loses its healthy neighbours.
            vecs = []
            for d in live:
                try:
                    vecs.append((await embeddings.embed_batch([d["content"]]))[0])
                except Exception as e:
                    vecs.append(None)
                    stats["failed"] += 1
                    failures.append(f"{d['id'][:8]}: {type(e).__name__}: {str(e)[:100]}")
        for d, v in zip(live, vecs):
            if v is None:
                continue
            try:
                conn.execute(
                    "INSERT OR IGNORE INTO documents "
                    "(id, content, title, tags, metadata, token_count, created_at, updated_at) "
                    "VALUES (?,?,?,?,?,?,?,?)",
                    (d["id"], d.get("content") or "", d.get("title"),
                     json.dumps(d.get("tags") or []),
                     json.dumps(d.get("metadata") or {}),
                     d.get("token_count") or 0,
                     d.get("created_at") or time.time(),
                     d.get("updated_at") or d.get("created_at") or time.time()))
                conn.execute(
                    "INSERT INTO document_embeddings(doc_id, embedding) VALUES (?, ?)",
                    (d["id"], db._serialize_vector(v)))
                stats["synced"] += 1
            except Exception as e:
                stats["failed"] += 1
                failures.append(f"{d['id'][:8]}: write: {type(e).__name__}: {str(e)[:100]}")
        conn.commit()
        done = sum(stats[k] for k in ("synced", "empty", "failed"))
        if args.progress_every and done % args.progress_every < args.batch:
            el = max(time.time() - started, 1e-9)
            print(f"  {done}/{len(missing)} · {stats['synced']} synced · "
                  f"{stats['failed']} failed · {done/el*60:.0f}/min", flush=True)

    print(json.dumps(stats, indent=2), flush=True)
    for f in failures[:20]:
        print(f"  FAILED {f}", file=sys.stderr, flush=True)

    # ⭐ Verify the OUTCOME, not the intent — the check that has caught every
    # migration bug in this project.
    n_docs = conn.execute("SELECT COUNT(*) FROM documents").fetchone()[0]
    n_emb = conn.execute("SELECT COUNT(*) FROM document_embeddings").fetchone()[0]
    print(f"\nafter: documents {n_docs} · document_embeddings {n_emb}", flush=True)
    if n_docs != n_emb:
        print(f"  ✗ {n_docs - n_emb} documents have NO embedding — they are "
              f"invisible to search while looking present in every listing",
              file=sys.stderr, flush=True)
        return 2
    if stats["failed"]:
        print(f"  ✗ {stats['failed']} failed — corpus is NOT at parity",
              file=sys.stderr, flush=True)
        return 1
    print("  ✓ every document has an embedding", flush=True)
    return 0


if __name__ == "__main__":
    sys.exit(asyncio.run(main()))
