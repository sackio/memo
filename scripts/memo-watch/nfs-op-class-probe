#!/bin/bash
# Which NFS metadata operation class is paying the /mnt/nas stall tax?
#
# WHY: arm A of the latency A/B (SETATTR on an existing per-host file) saw 65.2% of
# minutes stalled where `cluster`'s nas-write-tail-sample saw 87.3% over the same window,
# with cadence and definition already matched. The residual is the OPERATION. cluster's
# op is CREATE + UNLINK of a `$$`-suffixed name -- it writes no data -- so the candidate
# explanation is that mutating the PARENT DIRECTORY is dearer than mutating one inode.
# ⛔ The earlier guess that its probe did a data write was wrong; corrected by cluster
#    2026-10-22 from its own script. `datawrite` below exists to test that term anyway,
#    because it is nearly free to carry and it is the obvious next question.
#
# ⭐ THE OPS ARE INTERLEAVED, NOT RUN IN BLOCKS. /mnt/nas stalls arrive in episodes with a
#    5.6s median and a 28.8s p95, so two ops measured in consecutive 10-minute blocks
#    would differ by which episodes they happened to contain. Round-robin at one cadence
#    makes every op share the same minutes.
#
# ⛔ DO NOT CHANGE BOUND. A changed bound looks exactly like a changed tail (see
#    nfs-latency-probe). This one is NOT an arm of that A/B and must not be pooled with it.
BOUND=60        # seconds. ⚠️ A FLOOR: SIGTERM cannot interrupt uninterruptible sleep.
CADENCE=2       # seconds between samples, serial, so each op is sampled every 12s with 6 ops.
# ⚠ ADDING AN OP CHANGED THE PER-OP CADENCE (10s -> 12s). That is harmless HERE because every
#    conclusion this probe supports is a PAIRED comparison within one round, where the ops are
#    2s apart whatever the round length. ⛔ It is NOT harmless for anything pooled across runs:
#    a per-op stall RATE is ceilinged by its cadence. Do not compare a v4 marginal to a v3 one.
SHARED=/mnt/nas/data/memo-watch/opclass-shared   # ⭐ every host writes HERE -- the contention arm
OWN=/mnt/nas/data/memo-watch/opclass-$(hostname) # per-host dir -- but this probe BUSIES it
# ⛔⛔ $IDLE IS THE DISCRIMINATOR THE v3rot RUN ASKED FOR, AND IT IS THE WHOLE POINT OF v4.
#    v3rot measured create_own stalling MORE than create_shared, p<0.0001, twice, under two
#    orders -- backwards from "six hosts contending on one parent directory is dearer". So
#    the direction is settled and the CAUSE is not. $OWN is not a clean "uncontended" arm:
#    this probe also keeps $HOT, $DW and pool/ under it, so it is the directory THIS host
#    hammers. $SHARED is visited six times as often and may simply stay warm in the server's
#    cache. $IDLE is a per-host directory with NOTHING else in it and nothing else touching
#    it -- creates only.
#    ⇒ create_idle ~ create_shared  => the term is SELF-INFLICTED HEAT on $OWN.
#      create_idle ~ create_own     => the term is VISIT FREQUENCY, i.e. warmth beats contention.
IDLE=/mnt/nas/data/memo-watch/opclass-idle-$(hostname)
POOL_N=180      # ⛔⛔ SEE setattr_cold BELOW -- this is a control, not a tuning knob.
LABEL="${1:?label, e.g. 20261022-pm}"
END_EPOCH="${2:?end time as epoch seconds}"
LOG="$HOME/.memo-watch/nfs-latency/$(hostname).opclass-$LABEL.log"   # ⛔ host-local on purpose
mkdir -p "$(dirname "$LOG")" "$SHARED" "$OWN" "$OWN/pool" "$IDLE"
HOT="$OWN/.hot"          # touched every round -- ONE inode, kept hot on purpose
DW="$OWN/.dw"            # ⛔ NOT $HOT. See below.
: > "$HOT"; : > "$DW"
# ⛔⛔ setattr_cold AND POOL_N EXIST BECAUSE THE FIRST VERSION OF THIS PROBE WAS CONFOUNDED,
#    AND IT SHOWED WITHIN TWO MINUTES: setattr read p50 17,286 ms against create_own's 69 ms,
#    the OPPOSITE of the directory-mutation hypothesis and far too large to believe. Cause:
#    setattr and datawrite both targeted ONE file that the probe itself was rewriting every
#    few seconds, while the create ops got a fresh inode every time. That is the same effect
#    measured on the memo-watch heartbeat earlier the same day -- `stat` on the actively
#    rewritten heartbeat took 9,160 ms while a sibling path in the same mount took 92 ms.
#    So the first run was comparing HOT-INODE vs COLD-INODE and calling it SETATTR vs CREATE.
#    ⇒ Three separate targets now: $HOT (deliberately hot), the pool (deliberately cold --
#      $POOL_N files visited round-robin, so each is revisited about every POOL_N rounds),
#      and $DW for the data write. ⭐ Keep setattr_hot: it is nfs-latency-probe's actual op
#      and arm A cannot be interpreted without it.
# ⛔⛔ THE HEADER GOES FIRST, BEFORE THE SETUP, AND THE SETUP IS TIMED.
#    It used to come AFTER the 180-file pool creation, so for the whole of setup the log
#    FILE DID NOT EXIST -- and on a degraded mount that is not a moment, it is minutes.
#    MEASURED 2026-10-22 18:37 on the v4idle launch: two minutes in, the six hosts had
#    created 13-59 of 180 pool files and not one log existed. "0 samples" from a probe
#    that is still setting up and "0 samples" from a probe that died are byte-identical,
#    and the only thing that told them apart was counting files in the pool directory by
#    hand. ⇒ Write the header first so the log's existence proves the probe started, and
#      log the setup as its own timed row so its cost is visible instead of being an
#      unexplained gap between the header's start= and the first sample.
printf '# opclass label=%s host=%s bound=%s cadence=%s shared=%s own=%s idle=%s start=%s end_epoch=%s\n' \
  "$LABEL" "$(hostname)" "$BOUND" "$CADENCE" "$SHARED" "$OWN" "$IDLE" "$(date -Is)" "$END_EPOCH" >> "$LOG"
_s0=$(date +%s%N)
i=0; while [ "$i" -lt "$POOL_N" ]; do : > "$OWN/pool/f$i"; i=$(( i + 1 )); done
_s1=$(date +%s%N)
printf '# setup pool_n=%s elapsed_ms=%s done=%s\n' \
  "$POOL_N" "$(( (_s1-_s0)/1000000 ))" "$(date -Is)" >> "$LOG"
i=0
while [ "$(date +%s)" -lt "$END_EPOCH" ]; do
  # ⛔⛔ THE ORDER ROTATES BY ROUND, AND THAT IS A CONTROL, NOT A FLOURISH. With a FIXED
  #    order the 17:10 run of 2026-10-22 read create_own at p50 28,470 ms against
  #    create_shared's 1,178 ms -- backwards from the contention hypothesis, and create_own
  #    sits immediately before create_shared. An op that runs into the ONSET of an episode
  #    absorbs it and makes whatever follows look cheap, so in a fixed order "which op is
  #    slow" and "which position is slow" are the same measurement. Rotating by round gives
  #    every op every position an equal number of times and separates them.
  r=$(( i / 6 )); p=$(( i % 6 ))
  case $(( (p + r) % 6 )) in
    0) OP=setattr_hot ;;
    1) OP=setattr_cold ;;
    2) OP=create_own ;;
    3) OP=create_shared ;;
    4) OP=create_idle ;;
    5) OP=datawrite ;;
  esac
  i=$(( i + 1 ))
  s=$(date +%s%N)
  case "$OP" in
    setattr_hot)   timeout "$BOUND" touch "$HOT" 2>/dev/null; rc=$? ;;
    setattr_cold)  timeout "$BOUND" touch "$OWN/pool/f$(( r % POOL_N ))" 2>/dev/null; rc=$? ;;
    datawrite)     timeout "$BOUND" dd if=/dev/zero of="$DW" bs=4096 count=1 \
                     conv=notrunc,fsync 2>/dev/null; rc=$? ;;
    create_own)    N="$OWN/.c.$$.$i"
                   timeout "$BOUND" touch "$N" 2>/dev/null; rc=$?
                   rm -f -- "$N" 2>/dev/null ;;
    create_shared) N="$SHARED/.c.$(hostname).$$.$i"
                   timeout "$BOUND" touch "$N" 2>/dev/null; rc=$?
                   rm -f -- "$N" 2>/dev/null ;;
    create_idle)   N="$IDLE/.c.$$.$i"
                   timeout "$BOUND" touch "$N" 2>/dev/null; rc=$?
                   rm -f -- "$N" 2>/dev/null ;;
  esac
  e=$(date +%s%N)
  # ⛔ The UNLINK is deliberately OUTSIDE the timed region. Timing create+unlink together
  #    would make this op two directory mutations against the others' one, and the result
  #    would not answer "is a directory mutation dearer than an inode mutation".
  printf '%s %s %s %s %s\n' "$(date -Is)" "$(hostname)" "$OP" "$rc" "$(( (e-s)/1000000 ))" >> "$LOG"
  sleep "$CADENCE"
done
rm -f -- "$HOT" "$DW" 2>/dev/null
find "$OWN/pool" -mindepth 1 -delete 2>/dev/null
find "$IDLE" -mindepth 1 -delete 2>/dev/null
printf '# opclass label=%s host=%s ENDED %s\n' "$LABEL" "$(hostname)" "$(date -Is)" >> "$LOG"
