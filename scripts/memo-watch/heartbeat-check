#!/usr/bin/env bash
# heartbeat-check — the OTHER half of the missed-run alarm. Runs on a DIFFERENT HOST's crond
# (server3) and reads memo-watch's heartbeat off NFS.
#
# ⛔ WHY IT CANNOT LIVE ON server4 WITH THE JOB IT WATCHES. A job that is not running cannot
#    report that it is not running — and that is the exact failure this whole loop was
#    corrected for on 2026-09-08, when the broker fired 798-810 and NOT ONE reached the seat:
#    6.5 hours of no monitoring produced output byte-identical to 13 clean windows. The watch's
#    own run-gap check (step 0) sees a gap only AFTER it ends, on the next run that happens.
#    This sees a gap WHILE IT IS OPEN, and it survives server4's crond dying, its crontab being
#    edited, and the host being down.
# ⚠️ WHAT IT STILL CANNOT SEE, stated rather than hidden: it shares the NFS mount and the ATC
#    broker with the thing it watches. NAS down or broker down ⇒ it alarms (correct direction).
#    server3 down ⇒ nothing watches the watch, and nothing tells you. That residual is real.
#
# EXIT CONTRACT (same convention as `run`, declared in cronguard-digest.conf):
#   0 = heartbeat fresh      -> silent
#   1 = heartbeat STALE      -> DMs `memo`. rc1 = findings.
#   2 = heartbeat UNREADABLE -> DMs `memo`. rc2 = unknown. Absence is NOT freshness.
set -u
export PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

HB=${MEMO_WATCH_HEARTBEAT:-/mnt/nas/data/memo-watch/heartbeat}
BROKER=${ATC_BROKER:-http://192.168.1.168:3030}
DM_TO=${MEMO_WATCH_DM_TO:-memo}
# ⛔⛔ DERIVE THIS, DO NOT PICK IT — AND RE-DERIVE IT WHEN THE UPSTREAM GUARD CHANGES.
#    History, because both wrong values were wrong for instructive reasons:
#    4200 ORIGINALLY, justified as "two missed 30-min windows plus slack" — an unexamined guess.
#    6300 BRIEFLY on 2026-10-04 02:43, after a real 90-min gap. That derivation used cronguard's
#      600s TIMEOUT as the run-duration term. ⛔ WRONG INPUT: a timeout is an upper bound on a hang,
#      not a duration. MEASURED the same morning over 3 control runs: 6.7s, 6.9s, 7.8s. Using the
#      timeout over-provisioned the threshold by ~45 min of detection latency.
#    ⇒ BACK TO 4200, re-derived against the FIXED guard:
#      cronguard 355a44e (2026-10-04, `scripts` seat) now rounds ELAPSED to the nearest minute before
#      the ceiling comparison (cronguard:468, feeding the decision at :470), so the one-second jitter
#      miss that produced the 90-min gap cannot recur. Worst legitimate gap is back to
#      cadence + ceiling-at-next-fire = 30 + 30 = 60 min, plus ~8s of run duration and ~1s of cron
#      jitter => ~3608s. 4200 leaves ~10 min of margin, and the observer error that used to inflate
#      this (a 600s-stale NFS attribute cache) is removed by the forced revalidation below.
#    ⭐ THE RULE: a staleness threshold is a FUNCTION of the upstream guard's worst legitimate gap.
#      When that guard is fixed, the threshold must come DOWN again — otherwise every upstream bug
#      permanently buys itself detection latency that nobody ever reclaims.
#    ⛔ Do not raise this to buy margin against a bug that has been fixed. Re-measure instead:
#      the defer pattern is in /tmp/cronguard-decisions.log on server4 (grep memo-watch).
STALE_S=${MEMO_WATCH_STALE_S:-4200}     # 70 min; derived above against cronguard >= 355a44e.
TMP=$(mktemp -d)
trap 'rm -rf "$TMP"' EXIT

dm() {  # dm <subject> <body>
  python3 - "$DM_TO" "$1" "$2" > "$TMP/dm.json" <<'PY'
import json,sys
print(json.dumps({"to":sys.argv[1],"from":"memo","durable":True,
                  "subject":sys.argv[2],"content":sys.argv[3]}))
PY
  # ⛔⛔ DECIDE ON THE HTTP CODE, NEVER ON curl's EXIT STATUS, AND NEVER ON NEITHER.
  #    The previous form here printed `DM HTTP=%{http_code}` and then `|| true` — it reported the
  #    code and decided on NOTHING, so a 404 printed "DM HTTP=404" and the script carried on exiting
  #    1 exactly as if the alarm had been delivered. A dead route is a 404 and curl still exits 0.
  #    This is the defect that silently killed scripts/atc-say-ben for a day; it was fixed in this
  #    loop's OTHER half (scripts/memo-watch/run) on 2026-10-02 and NOT carried across until now.
  #    ⇒ When you fix a defect in one half of a two-host loop, fix the other half in the same pass.
  if [ -n "${MEMO_WATCH_NO_DM:-}" ]; then
    echo "  ⚠️ MEMO_WATCH_NO_DM set -- DM SUPPRESSED (control run). Payload that would have been sent:"
    sed 's/^/     /' "$TMP/dm.json" | head -3
    # ⭐ A CONTROL RUN MUST STILL EXERCISE THE SEND PATH, or it is a dry-run/real-send split that
    #    masks a dead route. Suppress the DELIVERY, never the RESOLUTION.
    RC_PROBE=$(curl -sS --max-time 15 -X POST "$BROKER/messages" -H 'Content-Type: application/json' \
                    -d '{}' -o "$TMP/route-probe.json" -w '%{http_code}' 2>/dev/null)
    if [ "$RC_PROBE" = "400" ] && command grep -q 'required' "$TMP/route-probe.json" 2>/dev/null; then
      echo "  ✅ send path VERIFIED: POST $BROKER/messages resolves (400 from the handler, not 404)"
    else
      echo "  ⛔ SEND PATH IS DEAD OR CHANGED: POST $BROKER/messages -> HTTP ${RC_PROBE:-<none>}"
      echo "     ⇒ A REAL finding would NOT have reached the seat. Fix the route before trusting silence."
    fi
    return 0
  fi
  DM_CODE=$(curl -sS --max-time 15 -X POST "$BROKER/messages" -H 'Content-Type: application/json' \
                 --data-binary @"$TMP/dm.json" -o "$TMP/dm-resp.json" -w '%{http_code}' 2>/dev/null)
  echo "  DM HTTP=${DM_CODE:-<none>}"
  case "${DM_CODE:-}" in
    2*) if command grep -q '"sent":0' "$TMP/dm-resp.json" 2>/dev/null; then
          echo "  ⛔ DM ACCEPTED BUT NOT ROUTED (sent:0) -- the finding stands and reached nobody."
          head -c 300 "$TMP/dm-resp.json"
        else
          echo "  ✅ DM accepted: $(head -c 200 "$TMP/dm-resp.json" 2>/dev/null)"
        fi ;;
    *)  echo "  ⛔ DM SEND FAILED (HTTP ${DM_CODE:-<none>}) -- the finding stands; it did not reach the seat."
        head -c 300 "$TMP/dm-resp.json" 2>/dev/null
        command grep -q 'no_such_route' "$TMP/dm-resp.json" 2>/dev/null \
          && echo "  ⛔⛔ no_such_route: THE ALARM PATH ITSELF IS BROKEN, not this one message." ;;
  esac
}

if ! timeout 25 test -f "$HB"; then
  echo "UNREADABLE: $HB does not exist or the mount did not answer in 25s"
  dm "⛔ memo-watch heartbeat UNREADABLE" \
     "heartbeat-check on $(hostname) could not read $HB (missing file, or the NFS mount did not answer within 25s).

⛔ THIS IS NOT EVIDENCE THE WATCH IS FINE AND IT IS NOT EVIDENCE IT IS DEAD. Absence is not freshness. Two different causes, both real: the watch is not running on server4, or /mnt/nas is not answering from $(hostname).

Check, in this order: ssh -p 4999 ben@server4 'tail -5 /home/ben/.memo-watch/run.out' (does the job still run?), then 'crontab -l | grep memo-watch', then the NFS mount here."
  exit 2
fi
# ⛔⛔ A BARE `stat` OVER NFS CAN BE UP TO 600s STALE, AND THAT ALWAYS READS AS *OLDER*.
#    MEASURED 2026-10-04 02:44 from server3: stat said the heartbeat was 5583s old (01:11:08) while
#    server4 saw the true 02:41:11 — a 90-MINUTE divergence on the SAME FILE. Cause is the mount's
#    own attribute cache, not a late write: /mnt/nas is nfs4 with acregmin=acregmax=acdirmin=
#    acdirmax=600. Re-reading the DIRECTORY forced revalidation and the value jumped to the truth.
#    ⇒ Force revalidation before judging, and prefer the file's OWN PAYLOAD over its metadata: the
#      writer stamps its epoch into the content, which is the producer's fact rather than the
#      filesystem's opinion about it.
#    ⭐ Both readings are LOWER BOUNDS on freshness — a cached attribute can only make the file look
#      older, never newer, and the stamp is monotonic. So max() of the available evidence is both the
#      best estimate and incapable of manufacturing a false "fresh".
timeout 25 ls -la "$(dirname "$HB")" >/dev/null 2>&1 || true     # force attribute revalidation
MT=$(timeout 25 stat -c %Y "$HB" 2>/dev/null || echo "")
CT=$(timeout 25 head -c 64 "$HB" 2>/dev/null | awk '{print $1}' | command grep -E '^[0-9]{10}$' || echo "")
if [ -z "$MT" ] && [ -z "$CT" ]; then
  echo "UNREADABLE: neither stat nor the content stamp on $HB answered"
  dm "⛔ memo-watch heartbeat UNREADABLE (stat+content)" \
     "Neither stat -c %Y nor the in-file epoch stamp on $HB answered within 25s from $(hostname), after a forced directory revalidation. Absence is not freshness."
  exit 2
fi
BEST=${MT:-0}; [ -n "$CT" ] && [ "$CT" -gt "$BEST" ] && BEST=$CT
if [ -n "$MT" ] && [ -n "$CT" ]; then
  SKEW=$(( MT > CT ? MT - CT : CT - MT ))
  [ "$SKEW" -gt 120 ] && echo "note: stat mtime and in-file stamp disagree by ${SKEW}s — using the fresher (${BEST}); suspect NFS attribute cache, not a stalled writer"
fi
AGE=$(( $(date +%s) - BEST ))
if [ "$AGE" -le "$STALE_S" ]; then
  echo "fresh: heartbeat ${AGE}s old (stale at ${STALE_S}s)"
  exit 0
fi
echo "STALE: heartbeat ${AGE}s old (> ${STALE_S}s)"
WINS=$(( AGE / 1800 - 1 )); [ "$WINS" -lt 1 ] && WINS=1
dm "⛔ memo-watch HAS NOT RUN for $((AGE / 60)) min" \
   "memo-watch's heartbeat ($HB) is $((AGE / 60)) min old (stale threshold ${STALE_S}s). Cadence is 30 min, so at least $WINS window(s) went UNWATCHED and the gap is STILL OPEN.

⛔ THIS SAYS THE WATCH IS NOT RUNNING. IT SAYS NOTHING ABOUT WHETHER memo IS UP — do not report it as a memo outage. On 2026-09-08 the loop went blind for 13 fires while memo itself was perfectly healthy (0 restarts, 297x200, no 5xx), and the danger was precisely that there was no outage to miss.

Checked from $(hostname), which is a different host's crond than the one running the job, so this is not self-reporting.

Next: ssh -p 4999 ben@server4 'tail -40 /home/ben/.memo-watch/run.out; crontab -l | grep memo-watch; tail -5 /tmp/cronguard-misses.log'"
exit 1
