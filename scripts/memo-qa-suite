#!/usr/bin/env python3
"""memo-qa-suite — the re-runnable comparison between memo builds. [002/FR-114]

Ben, 2026-08-03: *"save all this benchmarking testing so that we can use it again
and again as we make improvements to the system."*

## ⭐ WHY A RESULTS STORE AND NOT JUST RE-RUNNING THE BENCHMARK

Every number this project had before today was a one-off from a specific
afternoon, quoted from chat. **Three of them turned out to be measuring something
other than what their label said:**

- `ok=490 fail=0` from the registry mirror — a post-hoc count over its own plan
  file, which cannot see whether the plan covered the right repos.
- R-14's "incumbent" — a **v2** build, not v1, so the headline "the cutover loses"
  was comparing two candidates and calling one of them the status quo.
- v1's rank-1 "0 in every band" — the harness called `/search-documents`, which
  v1 does not expose. Every query 404'd. **The table read as a result and was an
  instrument failure.**

⇒ ⛔ **None of those were careless readings. They are what happens when a number
is separated from the configuration that produced it.** So every run here records
the config it measured, read back off the LIVE services, alongside the result.

## ⭐ WHAT EACH RUN RECORDS, AND WHY EACH FIELD IS THERE

| field | why |
|---|---|
| `git_sha`, `dirty` | a result from an uncommitted tree is not reproducible; say so |
| `targets[].resolved` | model/dims/url read from the RUNNING service, never from compose — this host's shell exports `EMBEDDING_MODEL=3-small` and has silently won before |
| `corpus` counts | a rank-1 % without its denominator cannot be re-checked later |
| raw `rank1`/`top5`/`absent`/`failures` per band | percentages are derived; store the integers |
| `failures` SEPARATE from `absent` | a query that never ran is not a retrieval miss. Conflating them is how a broken probe reads as a bad model |
| `seed`, `per_band` | stratified n means composition CANNOT affect the total; anyone comparing totals needs to know that |

⚠️ **The totals here are UNWEIGHTED MEANS of the five band rates**, because n is
fixed per band. That makes them immune to corpus composition **by construction** —
so do not "defend" a total with an argument about corpus mix; the design already
excluded it. (`embeddings` seat, 2026-08-03, correcting exactly that error here.)
⛔ **What composition DOES change is which memos populate each band.** A harder
pool inside a band shows up as a lower band rate, and neither n nor seed touches
it. That confound is real, unexamined, and not the one the stratification handles.

## ⛔ EVERY PROBE MUST BE ABLE TO FAIL

Each task records `control_ok`. A task whose positive control did not fire is
reported as **`could_not_run`**, never as a score of zero. The three states are
`ok` / `failed` / `could_not_run` and the third is never folded into the second.
*A detector that has never been run against a known positive is not a detector.*
"""
from __future__ import annotations

import argparse
import json
import os
import subprocess
import sys
import time
import urllib.error
import urllib.request
from datetime import datetime, timezone
from pathlib import Path

REPO = Path(__file__).resolve().parents[1]
RESULTS = REPO / "bench" / "results"
SAMPLES = REPO / "bench" / "samples"

# Search paths differ per build. v1 exposes ONLY /search; v2 exposes the explicit
# endpoints. Auto-detecting the wrong one is what made v1 look like it retrieved
# nothing, so the suite probes and RECORDS which it used.
CANDIDATE_PATHS = {
    "document": "/search-documents",
    "passages": "/search-passages",
    "v1-search": "/search",
}


def _post(url: str, path: str, body: dict, timeout: float = 60.0):
    req = urllib.request.Request(
        url.rstrip("/") + path, data=json.dumps(body).encode(),
        headers={"Content-Type": "application/json"})
    with urllib.request.urlopen(req, timeout=timeout) as r:
        return json.loads(r.read())


def _get(url: str, path: str, timeout: float = 180.0):
    with urllib.request.urlopen(url.rstrip("/") + path, timeout=timeout) as r:
        return json.loads(r.read())


def git_state() -> dict:
    def sh(*a):
        try:
            return subprocess.run(a, cwd=REPO, capture_output=True,
                                  text=True, timeout=15).stdout.strip()
        except Exception:
            return ""
    return {"sha": sh("git", "rev-parse", "--short", "HEAD"),
            "dirty": bool(sh("git", "status", "--porcelain"))}


def resolve_target(name: str, url: str, container: str | None) -> dict:
    """Read the config off the RUNNING service, not off any file.

    ⚠️ LOAD-BEARING. This host exports EMBEDDING_MODEL=…-3-small and
    EMBEDDING_DIMENSIONS=1536 in the shell. A `${VAR:-default}` in compose takes
    the SHELL's value, so a container has come up on 3-small while the file said
    3-large — caught only because dimensions were read back off the live tables.
    """
    out = {"name": name, "url": url, "container": container,
           "reachable": False, "resolved": None, "search_paths": {}}
    try:
        _get(url, "/health", timeout=10)
        out["reachable"] = True
    except Exception as e:
        out["error"] = f"health: {e}"
        return out

    for label, p in CANDIDATE_PATHS.items():
        try:
            _post(url, p, {"query": "probe", "limit": 1}, timeout=30)
            out["search_paths"][label] = "present"
        except urllib.error.HTTPError as e:
            out["search_paths"][label] = f"http {e.code}"
        except Exception as e:
            out["search_paths"][label] = f"err {type(e).__name__}"

    if container:
        # ⚠️ `getattr(..., None)` per field, NOT attribute access. v1's settings
        # has no `embedding_base_url` at all (it hard-codes OpenRouter in
        # embeddings.py), so `s.embedding_base_url` raises AttributeError, stdout
        # comes back EMPTY, and an stdout-only probe reports that as "docker exec
        # returned nothing" — blaming the transport for a bug in the probe.
        # ⇒ **Capture stderr, and let a build legitimately lack a field.**
        code = ("import sys,json;sys.path.insert(0,'/app/src');"
                "from memo.config import settings as s;"
                "print(json.dumps({k:getattr(s,k,None) for k in "
                "('embedding_model','embedding_dimensions','embedding_base_url')}))")
        last_err = None
        for _ in range(4):  # docker exec on this host DOES also intermittently return nothing
            r = subprocess.run(["docker", "exec", container, "python3", "-c", code],
                               capture_output=True, text=True, timeout=60)
            if r.stdout.strip():
                try:
                    d = json.loads(r.stdout.strip())
                    out["resolved"] = {"model": d.get("embedding_model"),
                                       "dims": d.get("embedding_dimensions"),
                                       "url": d.get("embedding_base_url")}
                except Exception:
                    out["resolved"] = {"raw": r.stdout.strip()[:200]}
                break
            last_err = (r.stderr or "").strip()[-300:] or f"exit {r.returncode}, no output"
            time.sleep(2)
        else:
            # ⛔ Three states. This is `could_not_tell`, and it now carries WHY.
            out["resolved"] = {"error": "could_not_tell", "detail": last_err}
    return out


def corpus(url: str) -> dict:
    docs = _get(url, "/documents?limit=20000")
    def toks(d):
        return d.get("token_count") or max(1, len(d.get("content") or "") // 4)
    return {"n": len(docs),
            "ge_1000": sum(1 for d in docs if toks(d) >= 1000),
            "ge_2000": sum(1 for d in docs if toks(d) >= 2000)}


# ---------------------------------------------------------------- task: recall
BANDS = [(0, 200), (200, 500), (500, 1000), (1000, 2000), (2000, 10 ** 9)]


def _toks(d):
    return d.get("token_count") or max(1, len(d.get("content") or "") // 4)


# ⭐⭐ R-17 — WHY THE QUESTIONS ARE PINNED TO A FILE AND NOT REGENERATED PER RUN
#
# Until 2026-08-03 both recall tasks drew their sample with `rng.sample(pool)`
# under a fixed seed, and the seed was believed to make two runs comparable.
# **It does not.** `random.sample` over a CHANGED POOL draws different documents
# even under the same seed: a seed makes a run reproducible against an UNCHANGED
# corpus, which is the one situation a benchmark is never used in.
#
# Measured cost of not knowing this: v1 received no code change and 6 extra
# documents, and moved −1.3pt on BOTH tasks. That made v1 an accidental control
# and put the floor of the whole instrument at ±1.3pt — large enough to have
# swallowed R-15's headline, which rested on a −0.3.
#
# ⇒ The sample is now a FILE of `{id, query}` pairs, minted once and re-used.
# ⭐ **The QUERY TEXT is stored, not just the id.** Pinning ids alone fixes which
# documents are asked about; it does not fix the QUESTION, because the
# content_query excerpt is derived from the body and would silently change if the
# body were edited. Storing the query makes a corpus edit change the corpus and
# not the question — which is the whole claim R-17 makes.
#
# ⛔ **A pinned id that has left the corpus is `missing`, never `absent`.**
# `absent` means the search failed to return a document that was there to return;
# a document that does not exist cannot be retrieved, and scoring it as a miss
# would charge a build for a corpus fact. Missing ids are excluded from n and
# counted in the open, so an eroding sample announces itself rather than quietly
# depressing every score. (Same shape as `failures` vs `absent`, already here.)


def _pool_own_title(docs, lo, hi):
    """Eligible (doc, query) pairs for own_title in one band."""
    return [(d, (d.get("title") or "")[:200])
            for d in docs
            if lo <= _toks(d) < hi and (d.get("title") or "").strip()]


def _pool_content_query(docs, lo, hi):
    """Eligible (doc, query) pairs for content_query in one band.

    ⛔ Skips documents whose excerpt would be mostly the title again (short
    memos), because scoring those would quietly re-run own_title under a new name.
    """
    pool = []
    for d in docs:
        if not (lo <= _toks(d) < hi):
            continue
        body = (d.get("content") or "").strip()
        title = (d.get("title") or "").strip()
        # drop markdown headers/blank lines, then take a mid-body window
        lines = [l.strip() for l in body.split("\n")
                 if l.strip() and not l.strip().startswith(("#", ">", "|", "-", "*"))]
        if len(lines) < 3:
            continue
        excerpt = " ".join(lines[len(lines) // 3:])[:180]
        if len(excerpt) < 60:
            continue
        if title and title[:40].lower() in excerpt.lower():
            continue  # would be own_title wearing a different name
        pool.append((d, excerpt))
    return pool


POOLS = {"own_title": _pool_own_title, "content_query": _pool_content_query}


def _score_band(url, path, items, corpus_ids, limit, timed=False):
    """Run one band's pinned questions and count outcomes.

    `items` is a list of {"id", "query"}. `corpus_ids` is the set of ids the
    target actually holds — pass None to skip the presence check.
    """
    rank1 = top5 = absent = failures = missing = 0
    lat = []
    for it in items:
        if corpus_ids is not None and it["id"] not in corpus_ids:
            missing += 1
            continue
        t0 = time.time()
        try:
            hits = _post(url, CANDIDATE_PATHS[path],
                         {"query": it["query"], "limit": limit})
        except Exception:
            # ⛔ A query that never ran is NOT a retrieval miss. Counting it
            # as `absent` is defensible; hiding it inside `absent` is not.
            failures += 1
            absent += 1
            continue
        lat.append((time.time() - t0) * 1000)
        ids = [(h.get("document", h) or {}).get("id") for h in hits]
        if ids and ids[0] == it["id"]:
            rank1 += 1
        if it["id"] in ids[:5]:
            top5 += 1
        if it["id"] not in ids:
            absent += 1
    lat.sort()
    out = {"n": len(items) - missing, "pinned": len(items), "missing": missing,
           "rank1": rank1, "top5": top5, "absent": absent, "failures": failures}
    if timed:
        out["p50_ms"] = round(lat[len(lat) // 2], 1) if lat else None
        out["p90_ms"] = round(lat[int(len(lat) * 0.9)], 1) if lat else None
    return out


def _band_label(lo, hi):
    return f"{lo}-{hi if hi < 10 ** 9 else ''}"


def _draw_bands(docs, task, per_band, seed):
    """Draw a fresh stratified sample — used to MINT a pinned file, and as the
    fallback when no pinned sample is supplied."""
    import random
    rng = random.Random(seed)
    out = []
    for lo, hi in BANDS:
        pool = POOLS[task](docs, lo, hi)
        sample = rng.sample(pool, min(per_band, len(pool)))
        out.append({"band": _band_label(lo, hi), "pool": len(pool),
                    "items": [{"id": d["id"], "query": q} for d, q in sample]})
    return out


def _run_recall_task(task, url, path, per_band, seed, sample=None, limit=10):
    """Shared body of own_title / content_query.

    With `sample`, the questions come from the pinned file and are identical
    across builds and across runs. Without it, they are drawn fresh — which is
    only correct for minting, and is recorded as `pinned_sample: null` so a
    reader can tell the two apart. ⛔ Do NOT compare a drawn run to a pinned one.
    """
    docs = _get(url, "/documents?limit=20000")
    corpus_ids = {d["id"] for d in docs}
    if sample is not None:
        src_bands = sample["tasks"][task]["bands"]
        sample_id = sample.get("sample_id")
    else:
        src_bands = _draw_bands(docs, task, per_band, seed)
        sample_id = None
    bands = []
    for b in src_bands:
        scored = _score_band(url, path, b["items"], corpus_ids, limit,
                             timed=(task == "own_title"))
        scored["band"] = b["band"]
        scored["pool"] = b.get("pool")
        bands.append(scored)
    ok_bands = [b for b in bands if b["n"]]
    total_missing = sum(b["missing"] for b in bands)
    return {"task": task, "path": path, "seed": seed, "per_band": per_band,
            "pinned_sample": sample_id, "bands": bands,
            "total_n": sum(b["n"] for b in bands),
            "total_pinned": sum(b["pinned"] for b in bands),
            # ⛔ Reported, never folded into absent — see the R-17 note above.
            "total_missing": total_missing,
            "total_rank1": sum(b["rank1"] for b in bands),
            # ⚠️ UNWEIGHTED mean of band rates — immune to corpus composition BY
            # CONSTRUCTION because n is fixed per band. Not a corpus-weighted score.
            "unweighted_rank1_pct": round(
                100 * sum(b["rank1"] / b["n"] for b in ok_bands) / len(ok_bands), 2)
            if ok_bands else None,
            "total_failures": sum(b["failures"] for b in bands),
            # ⛔ control: the questions must have actually been ASKED. Zero rank-1
            # over a real sample is a RESULT; zero rank-1 because every pinned id
            # had left the corpus is an instrument failure wearing its face.
            "control_ok": bool(ok_bands),
            "status": "ok" if ok_bands else "could_not_run"}


def task_own_title(url: str, path: str, per_band: int, seed: int,
                   sample=None, limit: int = 10) -> dict:
    """Search a memo's exact title; rank 1 is the only correct answer.

    The own-title set is free supervision — every memo is a labelled example with
    an unambiguous right answer, no hand-labelling and no LLM in the loop.
    """
    return _run_recall_task("own_title", url, path, per_band, seed, sample, limit)


# ------------------------------------------------------ task: content query
def task_content_query(url: str, path: str, per_band: int, seed: int,
                       sample=None, limit: int = 10) -> dict:
    """Query by a CONTENT excerpt instead of the exact title.

    ⭐ **own_title is unrealistically easy and we have been treating it as the
    whole picture.** Nobody searches memo by pasting a memo's exact title; they
    search for something they half-remember from the body. This asks the harder
    and more representative question — and it is still free supervision, because
    the excerpt's source document is the unambiguous right answer.

    ⚠️ Expect LOWER scores than own_title on both builds. That is the point — a
    task everything passes cannot discriminate between builds.
    ⛔ Skips documents whose excerpt would be mostly the title again (short
    memos), because scoring those would quietly re-run own_title under a new name.

    ⚠️ **This docstring used to claim "deterministic by construction: re-running
    with the same seed asks the same questions."** That was true only of the
    excerpt EXTRACTION, not of the sample — and the sample is where the questions
    come from. See the R-17 note above `_pool_own_title`. Determinism now comes
    from the pinned file, not from the seed.
    """
    return _run_recall_task("content_query", url, path, per_band, seed, sample, limit)


# ------------------------------------------------------- task: set-stability
def task_set_stability(url: str, path: str, n: int, seed: int,
                       replicates: int = 3) -> dict:
    """T287: is retrieval SET-stable, not merely RANK-stable?

    Measured 2026-08-03: target rank never varied (0/25) while the returned ID
    LIST varied 11/25. ⇒ two identical /recall calls can cite different
    SUPPORTING documents. Whether that is a defect is a REQUIREMENTS question
    and is deliberately not decided here — this only measures it.
    """
    import random
    docs = _get(url, "/documents?limit=20000")
    rng = random.Random(seed)
    sample = rng.sample([d for d in docs if (d.get("title") or "").strip()],
                        min(n, len(docs)))
    rank_var = set_var = ran = 0
    for d in sample:
        seen = []
        for _ in range(replicates):
            try:
                hits = _post(url, CANDIDATE_PATHS[path],
                             {"query": (d.get("title") or "")[:200], "limit": 10})
            except Exception:
                seen = []
                break
            seen.append([(h.get("document", h) or {}).get("id") for h in hits])
        if len(seen) != replicates:
            continue
        ran += 1
        if len({s[0] if s else None for s in seen}) > 1:
            rank_var += 1
        if len({tuple(s) for s in seen}) > 1:
            set_var += 1
    return {"task": "set_stability", "path": path, "n_requested": n, "n_ran": ran,
            "replicates": replicates,
            "rank1_varied": rank_var, "id_list_varied": set_var,
            "control_ok": ran > 0,
            "status": "ok" if ran > 0 else "could_not_run"}


# ------------------------------------------------- task: API surface contract
def task_api_surface(url: str) -> dict:
    """Route inventory + response SHAPE. A cutover breaks on shape, not accuracy.

    Records routes and the observed shape of a search hit so two builds can be
    diffed structurally rather than by eyeballing one response each.
    """
    out = {"task": "api_surface", "routes": None, "search_shape": {}}
    try:
        spec = _get(url, "/openapi.json", timeout=30)
        out["routes"] = sorted(spec.get("paths", {}).keys())
    except Exception as e:
        out["routes_error"] = str(e)
    for label, p in CANDIDATE_PATHS.items():
        try:
            hits = _post(url, p, {"query": "barn cluster node inventory", "limit": 2})
        except Exception as e:
            out["search_shape"][label] = {"error": type(e).__name__}
            continue
        row = hits[0] if isinstance(hits, list) and hits else None
        out["search_shape"][label] = {
            "container": type(hits).__name__,
            "row_keys": sorted(row.keys()) if isinstance(row, dict) else None,
            "doc_keys": sorted((row.get("document") or {}).keys())
            if isinstance(row, dict) and isinstance(row.get("document"), dict) else None,
        }
    out["control_ok"] = bool(out.get("routes"))
    out["status"] = "ok" if out["control_ok"] else "could_not_run"
    return out


# ------------------------------------------------------------- sample minting
def mint_sample(path: Path, url: str, per_band: int, seed: int,
                stamp: str) -> int:
    """Draw one stratified sample and freeze it as the question set.

    ⭐ **Mint from the corpus the builds are SYNCED TO, not from a candidate.**
    Minting from v2 would pin questions about the 88 documents v2 holds and v1
    does not, and every one of them would score `missing` on v1 — an artefact of
    where the sample came from, reported as a property of v1.

    ⚠️ Re-minting resets the baseline. Every stored result names the sample it
    used (`run.sample.id`); `memo-qa-diff` refuses to subtract across two ids.
    """
    docs = _get(url, "/documents?limit=20000")
    if not docs:
        print(f"✗ {url} returned no documents — refusing to mint an empty sample",
              file=sys.stderr)
        return 1
    out = {"schema": 1, "sample_id": f"s-{stamp}", "created_utc": stamp,
           "minted_from": {"url": url, "corpus_n": len(docs)},
           "git": git_state(), "seed": seed, "per_band": per_band, "tasks": {}}
    for task in ("own_title", "content_query"):
        bands = _draw_bands(docs, task, per_band, seed)
        out["tasks"][task] = {"bands": bands}
        n = sum(len(b["items"]) for b in bands)
        thin = [b["band"] for b in bands if len(b["items"]) < per_band]
        print(f"  {task}: {n} questions across {len(bands)} bands"
              + (f"  ⚠️ under-filled: {', '.join(thin)}" if thin else ""))
    # ⛔ A sample whose questions are not unique would score the same document
    # twice and quietly weight it double.
    for task, spec in out["tasks"].items():
        ids = [i["id"] for b in spec["bands"] for i in b["items"]]
        if len(ids) != len(set(ids)):
            print(f"✗ {task}: {len(ids) - len(set(ids))} duplicate ids",
                  file=sys.stderr)
            return 1
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(json.dumps(out, indent=2))
    print(f"\nwrote {path}  (sample_id {out['sample_id']})")
    return 0


# ------------------------------------------------------------------- runner
TASKS = ("own_title", "content_query", "set_stability", "api_surface")


def main() -> int:
    ap = argparse.ArgumentParser(description=__doc__,
                                 formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("--v1-url", default="http://server4:8000")
    ap.add_argument("--v2-url", default="http://localhost:8091")
    ap.add_argument("--v1-container", default="memo")
    ap.add_argument("--v2-container", default="memo-v2")
    ap.add_argument("--per-band", type=int, default=60)
    ap.add_argument("--seed", type=int, default=7)
    ap.add_argument("--stability-n", type=int, default=25)
    ap.add_argument("--tasks", default=",".join(TASKS))
    ap.add_argument("--label", default="", help="free-text note stored with the run")
    ap.add_argument("--out", default=None)
    ap.add_argument("--sample", default=str(SAMPLES / "default.json"),
                    help="pinned question file (see --mint-sample). "
                         "Pass 'none' to draw fresh — NOT comparable across runs.")
    ap.add_argument("--mint-sample", metavar="PATH", default=None,
                    help="draw a fresh stratified sample from --mint-from and "
                         "write it as a pinned question file, then exit")
    ap.add_argument("--mint-from", default=None,
                    help="corpus to mint from (default: --v1-url, the corpus both "
                         "builds are synced to)")
    args = ap.parse_args()

    stamp = datetime.now(timezone.utc).strftime("%Y-%m-%dT%H%M%SZ")

    if args.mint_sample:
        return mint_sample(Path(args.mint_sample), args.mint_from or args.v1_url,
                           args.per_band, args.seed, stamp)

    sample = None
    if args.sample and args.sample.lower() != "none":
        p = Path(args.sample)
        if p.exists():
            sample = json.loads(p.read_text())
            print(f"pinned sample: {p} ({sample.get('sample_id')})", flush=True)
        else:
            # ⛔ Do not silently fall back to drawing. A drawn run and a pinned run
            # look identical in the results file except for one null field, and
            # the whole point of R-17 is that the difference is invisible in the
            # NUMBERS. Say it here, loudly, at the moment it becomes true.
            print(f"⚠️  no pinned sample at {p} — DRAWING FRESH. This run is "
                  f"reproducible but NOT comparable to any other run.\n"
                  f"    Mint one:  {Path(__file__).name} --mint-sample {p}",
                  file=sys.stderr, flush=True)

    want = [t.strip() for t in args.tasks.split(",") if t.strip()]
    run = {"schema": 2, "run_id": stamp, "label": args.label,
           "git": git_state(), "seed": args.seed, "per_band": args.per_band,
           "sample": ({"id": sample.get("sample_id"), "path": args.sample,
                       "minted_from": sample.get("minted_from")}
                      if sample else None),
           "targets": [], "results": {}}

    targets = [("v1", args.v1_url, args.v1_container),
               ("v2", args.v2_url, args.v2_container)]
    for name, url, cont in targets:
        t = resolve_target(name, url, cont)
        if t["reachable"]:
            try:
                t["corpus"] = corpus(url)
            except Exception as e:
                t["corpus"] = {"error": str(e)}
        run["targets"].append(t)
        print(f"{name}: reachable={t['reachable']} resolved={t.get('resolved')}",
              flush=True)
        print(f"    paths={t['search_paths']}", flush=True)

    for name, url, _ in targets:
        tgt = next(t for t in run["targets"] if t["name"] == name)
        if not tgt["reachable"]:
            run["results"][name] = {"status": "could_not_run",
                                    "why": "service unreachable"}
            continue
        # Pick the search path this build actually exposes, and RECORD it.
        paths = [p for p, v in tgt["search_paths"].items() if v == "present"]
        primary = ("document" if "document" in paths
                   else "v1-search" if "v1-search" in paths
                   else (paths[0] if paths else None))
        if primary is None:
            run["results"][name] = {"status": "could_not_run",
                                    "why": "no working search path"}
            continue
        res = {"primary_path": primary, "paths_present": paths}
        for task in want:
            print(f"  [{name}] {task} …", flush=True)
            t0 = time.time()
            try:
                if task == "own_title":
                    r = {p: task_own_title(url, p, args.per_band, args.seed, sample)
                         for p in paths}
                elif task == "content_query":
                    r = {p: task_content_query(url, p, args.per_band, args.seed,
                                               sample)
                         for p in paths}
                elif task == "set_stability":
                    r = task_set_stability(url, primary, args.stability_n, args.seed)
                elif task == "api_surface":
                    r = task_api_surface(url)
                else:
                    r = {"status": "could_not_run", "why": f"unknown task {task}"}
            except Exception as e:
                r = {"status": "could_not_run", "why": f"{type(e).__name__}: {e}"}
            if isinstance(r, dict):
                r["elapsed_s"] = round(time.time() - t0, 1)
            res[task] = r
        run["results"][name] = res

    RESULTS.mkdir(parents=True, exist_ok=True)
    out = Path(args.out) if args.out else RESULTS / f"qa-{stamp}.json"
    out.write_text(json.dumps(run, indent=2))
    print(f"\nwrote {out}")

    for name in ("v1", "v2"):
        r = run["results"].get(name, {})
        for task in ("own_title", "content_query"):
            tr = r.get(task) or {}
            for path, v in (tr.items() if isinstance(tr, dict)
                            and "task" not in tr else []):
                if not (isinstance(v, dict) and v.get("status") == "ok"):
                    continue
                # ⚠️ `missing` is printed on the SAME line as the score, not in a
                # footnote — a score computed over a shrunken denominator must not
                # be readable without the denominator that produced it.
                miss = v.get("total_missing") or 0
                print(f"  {name:3} {task:14} {path:10} unweighted rank-1 "
                      f"{v['unweighted_rank1_pct']}%  "
                      f"({v['total_rank1']}/{v['total_n']}, "
                      f"{v['total_failures']} query failures"
                      + (f", ⚠️ {miss} pinned ids NOT IN THIS CORPUS" if miss else "")
                      + ")")
    return 0


if __name__ == "__main__":
    sys.exit(main())
