#!/usr/bin/env python3
"""memo-qa-suite — the re-runnable comparison between memo builds. [002/FR-114]

Ben, 2026-08-03: *"save all this benchmarking testing so that we can use it again
and again as we make improvements to the system."*

## ⭐ WHY A RESULTS STORE AND NOT JUST RE-RUNNING THE BENCHMARK

Every number this project had before today was a one-off from a specific
afternoon, quoted from chat. **Three of them turned out to be measuring something
other than what their label said:**

- `ok=490 fail=0` from the registry mirror — a post-hoc count over its own plan
  file, which cannot see whether the plan covered the right repos.
- R-14's "incumbent" — a **v2** build, not v1, so the headline "the cutover loses"
  was comparing two candidates and calling one of them the status quo.
- v1's rank-1 "0 in every band" — the harness called `/search-documents`, which
  v1 does not expose. Every query 404'd. **The table read as a result and was an
  instrument failure.**

⇒ ⛔ **None of those were careless readings. They are what happens when a number
is separated from the configuration that produced it.** So every run here records
the config it measured, read back off the LIVE services, alongside the result.

## ⭐ WHAT EACH RUN RECORDS, AND WHY EACH FIELD IS THERE

| field | why |
|---|---|
| `git_sha`, `dirty` | a result from an uncommitted tree is not reproducible; say so |
| `targets[].resolved` | model/dims/url read from the RUNNING service, never from compose — this host's shell exports `EMBEDDING_MODEL=3-small` and has silently won before |
| `corpus` counts | a rank-1 % without its denominator cannot be re-checked later |
| raw `rank1`/`top5`/`absent`/`failures` per band | percentages are derived; store the integers |
| `failures` SEPARATE from `absent` | a query that never ran is not a retrieval miss. Conflating them is how a broken probe reads as a bad model |
| `seed`, `per_band` | stratified n means composition CANNOT affect the total; anyone comparing totals needs to know that |

⚠️ **The totals here are UNWEIGHTED MEANS of the five band rates**, because n is
fixed per band. That makes them immune to corpus composition **by construction** —
so do not "defend" a total with an argument about corpus mix; the design already
excluded it. (`embeddings` seat, 2026-08-03, correcting exactly that error here.)
⛔ **What composition DOES change is which memos populate each band.** A harder
pool inside a band shows up as a lower band rate, and neither n nor seed touches
it. That confound is real, unexamined, and not the one the stratification handles.

## ⛔ EVERY PROBE MUST BE ABLE TO FAIL

Each task records `control_ok`. A task whose positive control did not fire is
reported as **`could_not_run`**, never as a score of zero. The three states are
`ok` / `failed` / `could_not_run` and the third is never folded into the second.
*A detector that has never been run against a known positive is not a detector.*
"""
from __future__ import annotations

import argparse
import json
import os
import random
import re
import subprocess
import sys
import time
import urllib.error
import urllib.request
from datetime import datetime, timezone
from pathlib import Path

REPO = Path(__file__).resolve().parents[1]
RESULTS = REPO / "bench" / "results"
SAMPLES = REPO / "bench" / "samples"

# ⭐ A path probe gets more than one shot. See resolve_target for why: a single
# transient timeout silently deleted a column from the comparison table on
# 2026-08-09, and the two runs it happened between disagreed about which paths
# the services even had.
PROBE_ATTEMPTS = 3
PROBE_RETRY_SLEEP_S = 3.0

# Search paths differ per build. v1 exposes ONLY /search; v2 exposes the explicit
# endpoints. Auto-detecting the wrong one is what made v1 look like it retrieved
# nothing, so the suite probes and RECORDS which it used.
CANDIDATE_PATHS = {
    "document": "/search-documents",
    "passages": "/search-passages",
    "v1-search": "/search",
}


# ⛔ THE HARNESS MUST BE SEPARABLE FROM REAL TRAFFIC IN v1's query_log.
# v1 logs every search with its user-agent so live usage can be replayed against
# v2 (Ben, 2026-08-03: *"compare the results from our real live usage"*).
# Measured 2026-08-03: 2,714 of 2,791 logged rows were `Python-urllib/3.10` from
# 192.168.0.109 — server4, which is where this harness runs. **The benchmark was
# drowning the log it exists to mine, and was indistinguishable from the fleet's
# own hooks, which are also Python and also on these hosts.** Attributing it by
# IP is an inference; a distinct agent string is a measurement.
UA = "memo-qa-suite/2 (benchmark; EXCLUDE-FROM-MIRROR)"


def _post(url: str, path: str, body: dict, timeout: float = 60.0):
    req = urllib.request.Request(
        url.rstrip("/") + path, data=json.dumps(body).encode(),
        headers={"Content-Type": "application/json", "User-Agent": UA})
    with urllib.request.urlopen(req, timeout=timeout) as r:
        return json.loads(r.read())


def _get(url: str, path: str, timeout: float = 180.0):
    req = urllib.request.Request(url.rstrip("/") + path,
                                 headers={"User-Agent": UA})
    with urllib.request.urlopen(req, timeout=timeout) as r:
        return json.loads(r.read())


def git_state() -> dict:
    def sh(*a):
        try:
            return subprocess.run(a, cwd=REPO, capture_output=True,
                                  text=True, timeout=15).stdout.strip()
        except Exception:
            return ""
    return {"sha": sh("git", "rev-parse", "--short", "HEAD"),
            "dirty": bool(sh("git", "status", "--porcelain"))}


def resolve_target(name: str, url: str, container: str | None,
                   probe_timeout: float = 30.0) -> dict:
    """Read the config off the RUNNING service, not off any file.

    ⚠️ LOAD-BEARING. This host exports EMBEDDING_MODEL=…-3-small and
    EMBEDDING_DIMENSIONS=1536 in the shell. A `${VAR:-default}` in compose takes
    the SHELL's value, so a container has come up on 3-small while the file said
    3-large — caught only because dimensions were read back off the live tables.
    """
    out = {"name": name, "url": url, "container": container,
           "reachable": False, "resolved": None, "search_paths": {}}
    try:
        _get(url, "/health", timeout=10)
        out["reachable"] = True
    except Exception as e:
        out["error"] = f"health: {e}"
        return out

    # ⭐ RETRIED, because a one-shot probe silently changes WHAT GOT MEASURED.
    # Measured 2026-08-09: two runs an hour apart against the same two services
    # disagreed about which paths existed — the first timed out on `document`
    # and scored `passages`, the second did the reverse. Neither run was wrong
    # about itself; the comparison table simply changed shape between them, and
    # nothing flagged that as a difference. A transient timeout must not be able
    # to remove a column.
    # ⛔ An HTTPError is NOT retried: 404 is a real answer about the API surface.
    # Only timeouts and transport errors get another attempt.
    for label, p in CANDIDATE_PATHS.items():
        attempts, last = 0, None
        for attempt in range(1, PROBE_ATTEMPTS + 1):
            attempts = attempt
            try:
                _post(url, p, {"query": "probe", "limit": 1},
                      timeout=probe_timeout)
                out["search_paths"][label] = "present"
                last = None
                break
            except urllib.error.HTTPError as e:
                out["search_paths"][label] = f"http {e.code}"
                last = None
                break
            except Exception as e:
                # ⚠️ RECORD THE BUDGET, not just the failure. A timeout here makes
                # the whole target `could_not_run` ("no working search path"), so a
                # service that is SLOW is reported identically to one that is
                # ABSENT. Measured 2026-08-03: during a host IO storm v1 answered
                # /search in 6.9s while a 30s probe had timed out minutes earlier —
                # the difference between "degraded" and "gone" was the load at the
                # instant I probed, and nothing in the record said so.
                last = e
                if attempt < PROBE_ATTEMPTS:
                    time.sleep(PROBE_RETRY_SLEEP_S)
        if last is not None:
            out["search_paths"][label] = (
                f"err {type(last).__name__} (probe budget {probe_timeout}s, "
                f"{attempts} attempts)")
        if attempts > 1:
            out.setdefault("probe_attempts", {})[label] = attempts

    if container:
        # ⚠️ `getattr(..., None)` per field, NOT attribute access. v1's settings
        # has no `embedding_base_url` at all (it hard-codes OpenRouter in
        # embeddings.py), so `s.embedding_base_url` raises AttributeError, stdout
        # comes back EMPTY, and an stdout-only probe reports that as "docker exec
        # returned nothing" — blaming the transport for a bug in the probe.
        # ⇒ **Capture stderr, and let a build legitimately lack a field.**
        code = ("import sys,json;sys.path.insert(0,'/app/src');"
                "from memo.config import settings as s;"
                "print(json.dumps({k:getattr(s,k,None) for k in "
                "('embedding_model','embedding_dimensions','embedding_base_url',"
                "'memo_retrieval_path')}))")
        last_err = None
        for _ in range(4):  # docker exec on this host DOES also intermittently return nothing
            # ⛔ TimeoutExpired MUST be caught here. The retry loop originally
            # handled only EMPTY stdout, so a slow docker daemon raised straight
            # out of resolve_target and killed the entire run with a traceback —
            # losing every task, for a CONFIG PROBE that is not the measurement.
            # Under host load `docker exec` routinely exceeds 60s.
            try:
                r = subprocess.run(
                    ["docker", "exec", container, "python3", "-c", code],
                    capture_output=True, text=True, timeout=60)
            except subprocess.TimeoutExpired:
                last_err = "docker exec timed out after 60s"
                time.sleep(2)
                continue
            except Exception as e:
                last_err = f"{type(e).__name__}: {e}"
                time.sleep(2)
                continue
            if r.stdout.strip():
                try:
                    d = json.loads(r.stdout.strip())
                    out["resolved"] = {"model": d.get("embedding_model"),
                                       "dims": d.get("embedding_dimensions"),
                                       "url": d.get("embedding_base_url"),
                                       # ⛔ WHICH INDEX ANSWERED. Two context_fit
                                       # runs on one build can differ purely
                                       # because this flipped, and without it
                                       # recorded the delta reads as a code
                                       # change. Same shape as R-14's
                                       # "incumbent".
                                       "retrieval_path": d.get("memo_retrieval_path")}
                except Exception:
                    out["resolved"] = {"raw": r.stdout.strip()[:200]}
                break
            last_err = (r.stderr or "").strip()[-300:] or f"exit {r.returncode}, no output"
            time.sleep(2)
        else:
            # ⛔ Three states. This is `could_not_tell`, and it now carries WHY.
            out["resolved"] = {"error": "could_not_tell", "detail": last_err}
    return out


def corpus(url: str) -> dict:
    docs = _get(url, "/documents?limit=20000")
    def toks(d):
        return d.get("token_count") or max(1, len(d.get("content") or "") // 4)
    return {"n": len(docs),
            "ge_1000": sum(1 for d in docs if toks(d) >= 1000),
            "ge_2000": sum(1 for d in docs if toks(d) >= 2000)}


# ---------------------------------------------------------------- task: recall
BANDS = [(0, 200), (200, 500), (500, 1000), (1000, 2000), (2000, 10 ** 9)]


def _toks(d):
    return d.get("token_count") or max(1, len(d.get("content") or "") // 4)


# ⭐⭐ R-17 — WHY THE QUESTIONS ARE PINNED TO A FILE AND NOT REGENERATED PER RUN
#
# Until 2026-08-03 both recall tasks drew their sample with `rng.sample(pool)`
# under a fixed seed, and the seed was believed to make two runs comparable.
# **It does not.** `random.sample` over a CHANGED POOL draws different documents
# even under the same seed: a seed makes a run reproducible against an UNCHANGED
# corpus, which is the one situation a benchmark is never used in.
#
# Measured cost of not knowing this: v1 received no code change and 6 extra
# documents, and moved −1.3pt on BOTH tasks. That made v1 an accidental control
# and put the floor of the whole instrument at ±1.3pt — large enough to have
# swallowed R-15's headline, which rested on a −0.3.
#
# ⇒ The sample is now a FILE of `{id, query}` pairs, minted once and re-used.
# ⭐ **The QUERY TEXT is stored, not just the id.** Pinning ids alone fixes which
# documents are asked about; it does not fix the QUESTION, because the
# content_query excerpt is derived from the body and would silently change if the
# body were edited. Storing the query makes a corpus edit change the corpus and
# not the question — which is the whole claim R-17 makes.
#
# ⛔ **A pinned id that has left the corpus is `missing`, never `absent`.**
# `absent` means the search failed to return a document that was there to return;
# a document that does not exist cannot be retrieved, and scoring it as a miss
# would charge a build for a corpus fact. Missing ids are excluded from n and
# counted in the open, so an eroding sample announces itself rather than quietly
# depressing every score. (Same shape as `failures` vs `absent`, already here.)


def _pool_own_title(docs, lo, hi, ctx=None):
    """Eligible (doc, query, extra) triples for own_title in one band."""
    return [(d, (d.get("title") or "")[:200], {})
            for d in docs
            if lo <= _toks(d) < hi and (d.get("title") or "").strip()]


def _pool_content_query(docs, lo, hi, ctx=None):
    """Eligible (doc, query, extra) triples for content_query in one band.

    ⛔ Skips documents whose excerpt would be mostly the title again (short
    memos), because scoring those would quietly re-run own_title under a new name.
    """
    pool = []
    for d in docs:
        if not (lo <= _toks(d) < hi):
            continue
        body = (d.get("content") or "").strip()
        title = (d.get("title") or "").strip()
        # drop markdown headers/blank lines, then take a mid-body window
        lines = [l.strip() for l in body.split("\n")
                 if l.strip() and not l.strip().startswith(("#", ">", "|", "-", "*"))]
        if len(lines) < 3:
            continue
        excerpt = " ".join(lines[len(lines) // 3:])[:180]
        if len(excerpt) < 60:
            continue
        if title and title[:40].lower() in excerpt.lower():
            continue  # would be own_title wearing a different name
        pool.append((d, excerpt, {}))
    return pool


# ------------------------------------------- task: answer recall / context fit
#
# ⭐⭐ THE TWO TASKS ABOVE MEASURE RETRIEVAL. BEN ASKED ABOUT SOMETHING ELSE.
#
# Ben, 2026-08-03: *"ground truth … ensuring that we're returning efficient
# context, not more not less than agents need."* `own_title` and `content_query`
# both score **did the right document rank first** — which is not the question an
# agent has. An agent asks *what port is the ATC broker on*, and is served or not
# served by whether **the answer is in the text that came back**. A build can rank
# the right document first and still hand back a passage that does not contain the
# fact, or pack the fact out of the response to fit a token budget.
#
# ⭐ FREE SUPERVISION, NO LLM JUDGE: use memos containing a **distinctive literal**
# — an IP, a MAC, a phone number, a dollar amount. The literal is the answer, and
# checking for it is exact string containment. No labelling, no model in the loop,
# nothing to drift. (An LLM judge would have been the obvious move and would have
# made every future re-run incomparable to this one.)
#
# ⛔ THE LITERAL MUST BE UNIQUE IN THE CORPUS. If two memos carry the same IP, a
# hit on the wrong memo contains the right string and scores as correct — the
# probe would be measuring string frequency and reporting it as accuracy.
# ⛔ AND UNIQUENESS IS A PROPERTY OF THE CORPUS BEING SCORED, NOT OF THE ONE THE
# SAMPLE WAS MINTED FROM. v2 holds 88 documents v1 does not; a literal unique in
# v1 may not be unique in v2. So uniqueness is RE-CHECKED at scoring time against
# the live corpus and violations are excluded and counted, never scored.
# ⛔ AND THE LITERAL MUST NOT APPEAR IN THE QUERY. The query is built from the
# title plus the words leading up to the literal, with the literal stripped —
# then asserted absent. Otherwise the probe measures echo, not recall.
#
# ⇒ THE THREE NUMBERS, and why all three are needed:
#   `right_doc_top1`   the old metric, kept side by side so the gap is visible
#   `answer_in_topk`   the answer came back at all           → GROUND TRUTH
#   `answer_in_context` it survived /context's token budget  → RIGHT-SIZED
# **`answer_in_topk` − `answer_in_context` is the answer the agent retrieved and
# then had truncated away** — the "not less than agents need" half, measured.
# `context_tokens` is the other half: what it cost to deliver.

ANSWER_PATTERNS = [
    # ⚠️ Deliberately few and deliberately strict. A wide pattern list looks more
    # thorough and produces a pool of false positives that scores like a result.
    ("ipv4", re.compile(r"\b(?:\d{1,3}\.){3}\d{1,3}(?::\d{2,5})?\b")),
    ("mac", re.compile(r"\b(?:[0-9a-fA-F]{2}:){5}[0-9a-fA-F]{2}\b")),
    ("phone", re.compile(r"\+1\d{10}\b")),
    ("money", re.compile(r"\$\s?\d[\d,]{2,}(?:\.\d{2})?")),
]


def _literals(text: str):
    """Extract candidate answer literals. Validates IPv4 octets, because
    `0.3.7.1`-shaped version strings are otherwise indistinguishable."""
    out = []
    for kind, rx in ANSWER_PATTERNS:
        for m in rx.finditer(text):
            tok = m.group(0)
            if kind == "ipv4":
                host = tok.split(":")[0]
                if any(not p.isdigit() or int(p) > 255 for p in host.split(".")):
                    continue
            out.append((kind, tok, m.start()))
    return out


def _prepare_answer(docs) -> dict:
    """Count how many DOCUMENTS carry each literal, once, for the whole corpus."""
    freq: dict[str, int] = {}
    for d in docs:
        for _, tok, _ in set((k, t, 0) for k, t, _ in
                             _literals(d.get("content") or "")):
            freq[tok] = freq.get(tok, 0) + 1
    return {"freq": freq}


def _pool_answer_recall(docs, lo, hi, ctx):
    freq = ctx["freq"]
    pool = []
    for d in docs:
        if not (lo <= _toks(d) < hi):
            continue
        body = (d.get("content") or "").strip()
        title = (d.get("title") or "").strip()
        if not title:
            continue
        for kind, tok, pos in _literals(body):
            if freq.get(tok, 0) != 1:
                continue                      # not unique → cannot be graded
            if tok in title:
                continue                      # the query would carry the answer
            lead = body[max(0, pos - 140):pos].replace("\n", " ").strip()
            query = f"{title} {lead}".strip()[:200]
            query = query.replace(tok, "").strip()
            if tok in query or len(query) < 40:
                continue                      # ⛔ asserted, not assumed
            pool.append((d, query, {"answer": tok, "answer_kind": kind}))
            break                             # one question per document
    return pool


def _passage_text(hit) -> str:
    """The span a passage hit actually delivers. Falls back to the document only
    when there is no passage — and a silent fallback is exactly the confound the
    caller is avoiding, so it is recorded per-hit rather than assumed."""
    p = hit.get("passage")
    if isinstance(p, dict) and (p.get("text") or "").strip():
        return p["text"]
    if isinstance(p, str) and p.strip():
        return p
    return (hit.get("document", hit) or {}).get("content") or ""


def _gradeable_answer_ids(url: str, sample) -> set:
    """Which pinned answer_recall items THIS corpus can grade. [2026-08-09]

    ⭐ Exists so every target is scored over the SAME questions.

    ⛔ THE BUG THIS CLOSES. Gradeability is a property of the corpus being
    scored, not of the sample: an item is dropped if its document is absent, or
    if its answer literal stopped being unique here. v2 holds 89 documents v1
    does not — so the two builds dropped DIFFERENT items and were scored over
    different denominators (229 vs 228 on 2026-08-09) while the output presented
    both as `answer_in_topk_pct`. Small that day, structural, and it grows with
    every divergence between the corpora.

    ⚠️ Returns ids, not counts. The intersection has to be taken across targets
    before any query runs, which is why this is a separate cheap pre-pass: it
    reads the corpus and nothing else.
    """
    if sample is None or "answer_recall" not in (sample.get("tasks") or {}):
        return set()
    docs = _get(url, "/documents?limit=20000")
    docs_by_id = {d["id"] for d in docs}
    freq = _prepare_answer(docs)["freq"]
    ok = set()
    for b in sample["tasks"]["answer_recall"]["bands"]:
        for it in b["items"]:
            if it["id"] in docs_by_id and freq.get(it["answer"], 0) == 1:
                ok.add(it["id"])
    return ok


def _score_answer_band(url, path, items, docs_by_id, freq, limit, budget,
                       only_ids=None):
    """Grade one band: did the ANSWER come back in the SEARCH results.

    ⚠️ `/context` is deliberately NOT called here. It takes a query and a budget
    and does not take a search path, so calling it inside this per-path loop made
    the SAME request once per path — two of every three were identical and
    discarded. Measured: v2 fell to ~3 questions/min and the run projected past
    four hours. `/context` is a property of the BUILD, so it is measured once per
    target in `task_context_fit`.
    """
    n = right1 = in_top1 = in_topk = in_topk_doc = failures = missing = ambiguous = 0
    off_common = 0
    for it in items:
        if it["id"] not in docs_by_id:
            missing += 1
            continue
        # ⛔ Re-check uniqueness against THIS corpus — see the note above.
        if freq.get(it["answer"], 0) != 1:
            ambiguous += 1
            continue
        # ⭐ COMMON DENOMINATOR. Gradeable here but not on every target, so it is
        # excluded from ALL of them and counted separately. Scoring it would make
        # this target's percentage rest on a question its rival never answered.
        if only_ids is not None and it["id"] not in only_ids:
            off_common += 1
            continue
        n += 1
        try:
            hits = _post(url, CANDIDATE_PATHS[path],
                         {"query": it["query"], "limit": limit})
        except Exception:
            failures += 1
            continue
        # ⛔ ON THE PASSAGES PATH, GRADE THE PASSAGE — NOT THE PARENT DOCUMENT.
        # Reading `document.content` here would hand every passage hit the FULL
        # document text, so `answer_in_topk` would collapse to recall@k and score
        # identically on both paths BY CONSTRUCTION. The probe would then be
        # unable to see the one thing passage retrieval changes — whether the
        # SPAN that came back carries the fact — and would report that blindness
        # as "no difference". What an agent receives is the passage.
        texts = [(_passage_text(h) if path == "passages"
                  else ((h.get("document", h) or {}).get("content") or ""))
                 for h in hits]
        ids = [(h.get("document", h) or {}).get("id") for h in hits]
        if ids and ids[0] == it["id"]:
            right1 += 1
        if texts and it["answer"] in texts[0]:
            in_top1 += 1
        if any(it["answer"] in t for t in texts):
            in_topk += 1
        # ⭐⭐ SAME HITS, GRADED ON THE FULL DOCUMENT INSTEAD OF THE SPAN.
        # `/search-passages` returns BOTH `passage.text` AND the complete
        # `document.content`, so "did the answer come back" has two honest
        # answers and MY GRADING CHOICE WOULD OTHERWISE DECIDE THE HEADLINE:
        #   - grade the span  -> what passage retrieval BUYS you, if the caller
        #                        reads the span (which is the entire point:
        #                        fewer tokens for the same answer)
        #   - grade the doc   -> what the caller ACTUALLY RECEIVES, since the
        #                        full text is on the wire regardless
        # Reporting one of these and not the other is an argument disguised as a
        # measurement. Both are recorded; the GAP between them is the finding.
        docs_text = [((h.get("document", h) or {}).get("content") or "")
                     for h in hits]
        if any(it["answer"] in t for t in docs_text):
            in_topk_doc += 1
    return {"n": n, "pinned": len(items), "missing": missing,
            # ⛔ Separate from `missing`: the document is here, the QUESTION is no
            # longer gradeable because the literal stopped being unique.
            "ambiguous": ambiguous, "failures": failures,
            # Gradeable HERE, dropped anyway so every target answers the same
            # questions. Distinct from `ambiguous`, which is about this corpus.
            "off_common": off_common,
            "right_doc_top1": right1, "answer_in_top1": in_top1,
            "answer_in_topk": in_topk, "answer_in_topk_fulldoc": in_topk_doc}


def task_answer_recall(url: str, path: str, per_band: int, seed: int,
                       sample=None, limit: int = 10, only_ids=None) -> dict:
    """Ground truth + context fit. See the block above ANSWER_PATTERNS."""
    if sample is not None and "answer_recall" not in (sample.get("tasks") or {}):
        return {"task": "answer_recall", "path": path, "status": "could_not_run",
                "why": f"pinned sample {sample.get('sample_id')} has no "
                       f"answer_recall questions — extend it with --mint-sample",
                "control_ok": False}
    docs = _get(url, "/documents?limit=20000")
    docs_by_id = {d["id"]: d for d in docs}
    freq = _prepare_answer(docs)["freq"]
    if sample is not None:
        src_bands = sample["tasks"]["answer_recall"]["bands"]
        sample_id = sample.get("sample_id")
    else:
        src_bands = _draw_bands(docs, "answer_recall", per_band, seed)
        sample_id = None
    bands = []
    for b in src_bands:
        scored = _score_answer_band(url, path, b["items"], docs_by_id, freq,
                                    limit, None, only_ids=only_ids)
        scored["band"] = b["band"]
        scored["pool"] = b.get("pool")
        bands.append(scored)
    ok = [b for b in bands if b["n"]]
    def pct(key):
        return round(100 * sum(b[key] / b["n"] for b in ok) / len(ok), 2) if ok else None
    return {"task": "answer_recall", "path": path, "seed": seed,
            "per_band": per_band, "pinned_sample": sample_id, "bands": bands,
            "total_n": sum(b["n"] for b in bands),
            "total_pinned": sum(b["pinned"] for b in bands),
            "total_missing": sum(b["missing"] for b in bands),
            "total_ambiguous": sum(b["ambiguous"] for b in bands),
            "total_off_common": sum(b.get("off_common", 0) for b in bands),
            # ⭐ Whether the common-denominator gate was applied at all. Without
            # this, a run where every target happened to agree and a run where
            # the gate was never passed in look identical.
            "common_denominator": only_ids is not None,
            "total_failures": sum(b["failures"] for b in bands),
            "right_doc_top1_pct": pct("right_doc_top1"),
            "answer_in_top1_pct": pct("answer_in_top1"),
            # ⭐ GROUND TRUTH: the fact came back, not merely the document.
            # Pair with context_fit.answer_in_context_pct on the SAME sample —
            # the difference is what was retrieved and then truncated away.
            "answer_in_topk_pct": pct("answer_in_topk"),
            # ⭐ The same hits graded on the full document text the API also
            # returns. On the `document` path these are identical by
            # construction; on `passages` the gap is what the span costs.
            "answer_in_topk_fulldoc_pct": pct("answer_in_topk_fulldoc"),
            "span_cost_pt": (round(pct("answer_in_topk_fulldoc")
                                   - pct("answer_in_topk"), 2) if ok else None),
            # ⛔ control: the questions must have been asked AND gradeable. Zero
            # answers over a real sample is a RESULT; zero because every literal
            # went ambiguous is an instrument failure wearing its face.
            "control_ok": bool(ok),
            "status": "ok" if ok else "could_not_run"}


def task_context_fit(url: str, per_band: int, seed: int, sample=None,
                     budget: int = 4000, limit: int = 10) -> dict:
    """⭐ BEN'S CONCERN (c): *"efficient context, not more not less than agents
    need."* Both halves, on the same questions as answer_recall.

    **NOT LESS:** `answer_in_context` — the fact survived the budget and reached
    the caller. Read against answer_recall's `answer_in_topk` on the same sample,
    the difference is the answer that was RETRIEVED and then truncated away.

    **NOT MORE:** what the call cost, and how much of it was redundant.
    `duplicate_docs_mean` counts returned documents whose content is byte-equal
    to another in the SAME response. That is not a hypothetical: 203 title-groups
    in this corpus hold 524 memos and 212k tokens of near-duplicate text, so a
    budget can be spent two and three times on one fact.

    ⛔ `/context` takes a query and a budget and NOT a search path, so this is a
    property of the build and is measured ONCE per target. Running it inside the
    per-path loop issued the identical request three times per question and put
    the run on a four-hour trajectory for two-thirds waste.
    """
    if sample is not None and "answer_recall" not in (sample.get("tasks") or {}):
        return {"task": "context_fit", "status": "could_not_run",
                "why": f"pinned sample {sample.get('sample_id')} has no "
                       f"answer_recall questions to reuse", "control_ok": False}
    docs = _get(url, "/documents?limit=20000")
    docs_by_id = {d["id"]: d for d in docs}
    freq = _prepare_answer(docs)["freq"]
    src = (sample["tasks"]["answer_recall"]["bands"] if sample is not None
           else _draw_bands(docs, "answer_recall", per_band, seed))
    n = in_ctx = failures = missing = ambiguous = trunc = 0
    toks, ndocs, dups, matched = [], [], [], []
    dropped = []   # server-reported dedupe, independent of any bundled change
    for b in src:
        for it in b["items"]:
            if it["id"] not in docs_by_id:
                missing += 1
                continue
            if freq.get(it["answer"], 0) != 1:
                ambiguous += 1
                continue
            n += 1
            try:
                ctx = _post(url, "/context",
                            {"query": it["query"], "token_budget": budget})
            except Exception:
                failures += 1
                continue
            body = ctx.get("content") or ""
            if it["answer"] in body:
                in_ctx += 1
            toks.append(ctx.get("token_count") or 0)
            ndocs.append(ctx.get("doc_count") or 0)
            matched.append(ctx.get("matched_count") or 0)
            # ⭐ ATTRIBUTION. Delivery moves for many reasons at once — here,
            # dedupe AND 43 newly-superseded memos landed together. This field
            # is reported by the server for the dedupe specifically, so its
            # effect stays readable inside a bundled change. `None` means the
            # build predates FR-119, which is NOT the same as zero duplicates.
            dropped.append(ctx.get("duplicates_dropped"))
            trunc += 1 if ctx.get("truncated") else 0
            # ⛔ THE OUTPUT-SIDE DUPLICATE COUNTER IS DELETED, NOT FIXED.
            # It split the packed markdown on "\n## " to recover sections — but
            # memos ARE markdown and carry their own `## ` subheadings, so one
            # 3-document response parsed as TWENTY sections and the "duplicates"
            # it reported were coincidentally-equal sub-blocks. It disagreed with
            # the server by 10x (0.35 vs 0.03) and the server was right.
            # ⚠️ I had already "fixed" this metric once — for comparing whole
            # sections including their differing score headers — which made a
            # structurally wrong instrument marginally less wrong and left it
            # measuring the same wrong thing.
            # ⇒ `duplicates_dropped` is reported by the server from DOCUMENT
            # IDENTITY. Re-deriving it by parsing formatted output is strictly
            # worse: it can only add failure modes to a number already known.
    mean = lambda xs: round(sum(xs) / len(xs), 2) if xs else None
    return {"task": "context_fit", "token_budget": budget,
            "pinned_sample": sample.get("sample_id") if sample else None,
            "total_n": n, "total_missing": missing,
            "total_ambiguous": ambiguous, "total_failures": failures,
            "answer_in_context_pct": round(100 * in_ctx / n, 2) if n else None,
            # ⭐⭐ THE COST METRIC. Ben, 2026-08-03: *"the more precise
            # information we can give to LLMs the less we spend."*
            #
            # ⛔ EVERY OTHER NUMBER IN THIS SUITE REWARDS SPENDING MORE. A packer
            # that fills its budget scores identically to one that answers in a
            # tenth of the tokens, so "better" has silently meant "more tokens"
            # for the whole project. Measured at the time this was added: 3,671
            # tokens for 0.908 answers ≈ 4,043 tokens PER ANSWER DELIVERED —
            # to return, in the common case, an IP address.
            #
            # ⚠️ Deliberately tokens ÷ ANSWERS, not tokens ÷ CALLS. Dividing by
            # calls rewards a build that returns nothing: zero tokens, perfect
            # score. Dividing by answers delivered makes silence expensive,
            # which is the direction that matches what a caller actually buys.
            # ⛔ So a build that spends FEWER tokens and delivers FEWER answers
            # does NOT automatically win here — read it beside
            # `answer_in_context_pct`, never alone. R-25 is the cautionary case:
            # span windowing cut tokens AND cut answers, and on a
            # tokens-per-call metric it would have looked like an improvement.
            "tokens_per_answer_delivered": (
                round((sum(toks) / len(toks)) / (in_ctx / n), 1)
                if (toks and n and in_ctx) else None),
            "context_tokens_mean": mean(toks),
            "context_docs_mean": mean(ndocs),
            "matched_count_mean": mean(matched),
            # ⚠️ `truncated` counts responses that hit the ceiling — the budget
            # bound the answer, rather than the corpus running out of matches.
            "truncated_pct": round(100 * trunc / n, 2) if n else None,
            # ⚠️ A LOWER BOUND on redundancy: exact repeats only, while the
            # corpus's real problem is NEAR-duplicates (203 title-groups, 524
            # memos, 212k tokens). A near-copy differing by one line counts as
            # two distinct answers here — which is why 0.03/call is a finding
            # about the RULE, not evidence the corpus is clean.
            # ⛔ `None` means the build predates FR-119. NOT the same as zero.
            "server_duplicates_dropped_mean": (
                mean([d for d in dropped if d is not None])
                if any(d is not None for d in dropped) else None),
            "budget_used_pct": round(100 * (sum(toks) / len(toks)) / budget, 1)
            if toks else None,
            "control_ok": n > 0,
            "status": "ok" if n > 0 else "could_not_run"}


POOLS = {"own_title": _pool_own_title, "content_query": _pool_content_query,
         "answer_recall": _pool_answer_recall}
PREPARE = {"answer_recall": _prepare_answer}


def _score_band(url, path, items, corpus_ids, limit, timed=False):
    """Run one band's pinned questions and count outcomes.

    `items` is a list of {"id", "query"}. `corpus_ids` is the set of ids the
    target actually holds — pass None to skip the presence check.
    """
    rank1 = top5 = absent = failures = missing = 0
    lat = []
    for it in items:
        if corpus_ids is not None and it["id"] not in corpus_ids:
            missing += 1
            continue
        t0 = time.time()
        try:
            hits = _post(url, CANDIDATE_PATHS[path],
                         {"query": it["query"], "limit": limit})
        except Exception:
            # ⛔ A query that never ran is NOT a retrieval miss. Counting it
            # as `absent` is defensible; hiding it inside `absent` is not.
            failures += 1
            absent += 1
            continue
        lat.append((time.time() - t0) * 1000)
        ids = [(h.get("document", h) or {}).get("id") for h in hits]
        if ids and ids[0] == it["id"]:
            rank1 += 1
        if it["id"] in ids[:5]:
            top5 += 1
        if it["id"] not in ids:
            absent += 1
    lat.sort()
    out = {"n": len(items) - missing, "pinned": len(items), "missing": missing,
           "rank1": rank1, "top5": top5, "absent": absent, "failures": failures}
    if timed:
        out["p50_ms"] = round(lat[len(lat) // 2], 1) if lat else None
        out["p90_ms"] = round(lat[int(len(lat) * 0.9)], 1) if lat else None
    return out


def _band_label(lo, hi):
    return f"{lo}-{hi if hi < 10 ** 9 else ''}"


def _draw_bands(docs, task, per_band, seed):
    """Draw a fresh stratified sample — used to MINT a pinned file, and as the
    fallback when no pinned sample is supplied."""
    rng = random.Random(seed)
    ctx = PREPARE[task](docs) if task in PREPARE else None
    out = []
    for lo, hi in BANDS:
        pool = POOLS[task](docs, lo, hi, ctx)
        sample = rng.sample(pool, min(per_band, len(pool)))
        out.append({"band": _band_label(lo, hi), "pool": len(pool),
                    "items": [dict(id=d["id"], query=q, **extra)
                              for d, q, extra in sample]})
    return out


def _run_recall_task(task, url, path, per_band, seed, sample=None, limit=10):
    """Shared body of own_title / content_query.

    With `sample`, the questions come from the pinned file and are identical
    across builds and across runs. Without it, they are drawn fresh — which is
    only correct for minting, and is recorded as `pinned_sample: null` so a
    reader can tell the two apart. ⛔ Do NOT compare a drawn run to a pinned one.
    """
    if sample is not None and task not in (sample.get("tasks") or {}):
        # ⛔ Not a zero. The pinned file predates this task; it has no questions
        # to ask, which is a different fact from asking them and getting nothing.
        return {"task": task, "path": path, "status": "could_not_run",
                "why": f"pinned sample {sample.get('sample_id')} has no "
                       f"{task} questions — extend it with --mint-sample",
                "control_ok": False}
    docs = _get(url, "/documents?limit=20000")
    corpus_ids = {d["id"] for d in docs}
    if sample is not None:
        src_bands = sample["tasks"][task]["bands"]
        sample_id = sample.get("sample_id")
    else:
        src_bands = _draw_bands(docs, task, per_band, seed)
        sample_id = None
    bands = []
    for b in src_bands:
        scored = _score_band(url, path, b["items"], corpus_ids, limit,
                             timed=(task == "own_title"))
        scored["band"] = b["band"]
        scored["pool"] = b.get("pool")
        bands.append(scored)
    ok_bands = [b for b in bands if b["n"]]
    total_missing = sum(b["missing"] for b in bands)
    return {"task": task, "path": path, "seed": seed, "per_band": per_band,
            "pinned_sample": sample_id, "bands": bands,
            "total_n": sum(b["n"] for b in bands),
            "total_pinned": sum(b["pinned"] for b in bands),
            # ⛔ Reported, never folded into absent — see the R-17 note above.
            "total_missing": total_missing,
            "total_rank1": sum(b["rank1"] for b in bands),
            # ⚠️ UNWEIGHTED mean of band rates — immune to corpus composition BY
            # CONSTRUCTION because n is fixed per band. Not a corpus-weighted score.
            "unweighted_rank1_pct": round(
                100 * sum(b["rank1"] / b["n"] for b in ok_bands) / len(ok_bands), 2)
            if ok_bands else None,
            "total_failures": sum(b["failures"] for b in bands),
            # ⛔ control: the questions must have actually been ASKED. Zero rank-1
            # over a real sample is a RESULT; zero rank-1 because every pinned id
            # had left the corpus is an instrument failure wearing its face.
            "control_ok": bool(ok_bands),
            "status": "ok" if ok_bands else "could_not_run"}


def task_own_title(url: str, path: str, per_band: int, seed: int,
                   sample=None, limit: int = 10) -> dict:
    """Search a memo's exact title; rank 1 is the only correct answer.

    The own-title set is free supervision — every memo is a labelled example with
    an unambiguous right answer, no hand-labelling and no LLM in the loop.
    """
    return _run_recall_task("own_title", url, path, per_band, seed, sample, limit)


# ------------------------------------------------------ task: content query
def task_content_query(url: str, path: str, per_band: int, seed: int,
                       sample=None, limit: int = 10) -> dict:
    """Query by a CONTENT excerpt instead of the exact title.

    ⭐ **own_title is unrealistically easy and we have been treating it as the
    whole picture.** Nobody searches memo by pasting a memo's exact title; they
    search for something they half-remember from the body. This asks the harder
    and more representative question — and it is still free supervision, because
    the excerpt's source document is the unambiguous right answer.

    ⚠️ Expect LOWER scores than own_title on both builds. That is the point — a
    task everything passes cannot discriminate between builds.
    ⛔ Skips documents whose excerpt would be mostly the title again (short
    memos), because scoring those would quietly re-run own_title under a new name.

    ⚠️ **This docstring used to claim "deterministic by construction: re-running
    with the same seed asks the same questions."** That was true only of the
    excerpt EXTRACTION, not of the sample — and the sample is where the questions
    come from. See the R-17 note above `_pool_own_title`. Determinism now comes
    from the pinned file, not from the seed.
    """
    return _run_recall_task("content_query", url, path, per_band, seed, sample, limit)



# ------------------------------------------------------- task: supersession
def task_supersession(url: str, path: str, edges_path: str,
                      limit: int = 10) -> dict:
    """⭐ BEN'S CONCERN (b): does newer information actually REPLACE older?

    Reads the edge list written by `memo-regenerate-supersede-edges`. Each edge
    carries a probe query taken from the OLD memo's BODY.

    ⛔ NOT "is the old memo still returned" — FR-115 excludes it by construction,
    so that question tests that a filter filters. **The question is what happened
    to the QUERY.** A query that used to find the old memo must now find its
    replacement. If it finds NEITHER, supersession destroyed recall rather than
    updating it, and R-16 already found the replacement usually is not returned —
    so that outcome is live, not hypothetical.

    ⛔ The probe is never the shared TITLE. Both memos carry it, so a title hit
    would say nothing about which VERSION the index prefers — that is own_title
    wearing a costume, a confound this project has already built once.
    """
    try:
        edges = json.loads(Path(edges_path).read_text())
    except Exception as e:
        return {"task": "supersession", "status": "could_not_run",
                "why": f"no edge list at {edges_path}: {type(e).__name__}",
                "control_ok": False}
    new_1 = new_5 = old_back = neither = failures = 0
    for e in edges:
        try:
            hits = _post(url, CANDIDATE_PATHS[path],
                         {"query": e["probe_query"], "limit": limit})
        except Exception:
            failures += 1
            continue
        ids = [(h.get("document", h) or {}).get("id") for h in hits]
        if ids and ids[0] == e["new_id"]:
            new_1 += 1
        if e["new_id"] in ids[:5]:
            new_5 += 1
        # ⛔ Must be 0 while FR-115 is active. Any hit here means the exclusion
        # is not working, and every other number in this row is then untrustworthy.
        if e["old_id"] in ids:
            old_back += 1
        if e["new_id"] not in ids and e["old_id"] not in ids:
            neither += 1
    n = len(edges) - failures
    pct = lambda k: round(100 * k / n, 2) if n else None
    return {"task": "supersession", "path": path, "edges": len(edges),
            "n_ran": n, "failures": failures,
            "replacement_at_1_pct": pct(new_1),
            "replacement_in_top5_pct": pct(new_5),
            # ⭐ THE COST OF SUPERSEDING: the query used to land on the old memo
            # and now lands on nothing relevant.
            "neither_returned_pct": pct(neither),
            "superseded_still_returned": old_back,
            "control_ok": n > 0 and old_back == 0,
            "status": "ok" if n > 0 else "could_not_run",
            "why": ("superseded memos are STILL being returned — FR-115 is not "
                    "filtering, so the rest of this row is meaningless"
                    if old_back else None)}


# ------------------------------------------------------ task: hard negatives
def task_hard_negatives(url: str, path: str, sample=None,
                        limit: int = 10, only_ids=None) -> dict:
    """⭐ Can the store tell the RIGHT value from a memo ABOUT that kind of value?

    Every other task here asks *did the right document come back*. This one asks
    whether a document carrying a **plausible wrong answer** outranks it.

    ⛔ WHY IT EXISTS. Measured 2026-08-06 on market theses: embedding similarity
    scores TOPIC, not CLAIM — 6 of 7 single-word polarity flips beat the true
    paraphrase, and *buy* lost to *sue* on one consonant. memo's corpus is far
    more exposed to this than that one: it is dense with near-identical infra
    facts separated by a single token — one octet of an IP, a port, a hostname.
    Nothing in this suite could distinguish *a memo about server4's IP* from
    *the memo with the correct IP*.

    ⇒ THE PROBE, and it needs no new corpus. Reuse the answer_recall items: each
    is (query, target document, unique answer literal). Run the query, then look
    only at hits ranked ABOVE the target. A hit is CONFUSABLE if it carries a
    literal of the SAME KIND with a DIFFERENT VALUE — an agent reading top-down
    finds a well-formed, wrong answer before the right one.

    ⛔ THE POSITIVE CONTROL IS THE WHOLE DESIGN. `confusable_present_pct` counts
    items where a confusable appeared ANYWHERE in top-k, above the target or
    below it. Without it, `confusable_above_target_pct: 0` is ambiguous between
    *"ranking is robust"* and *"this corpus has nothing to confuse it with"* —
    and the healthy-looking reading is the wrong one exactly when the sample is
    degenerate. That is the near-duplicate-detector trap from 2026-08-06,
    which returned CLEAN on a corpus with nothing to duplicate.
    """
    if sample is None or "answer_recall" not in (sample.get("tasks") or {}):
        return {"task": "hard_negatives", "path": path, "status": "could_not_run",
                "why": "needs the answer_recall items from a pinned sample",
                "control_ok": False}
    docs = _get(url, "/documents?limit=20000")
    docs_by_id = {d["id"]: d for d in docs}
    freq = _prepare_answer(docs)["freq"]

    n = failures = rank1 = above = present = target_absent = 0
    examples = []
    for b in sample["tasks"]["answer_recall"]["bands"]:
        for it in b["items"]:
            if it["id"] not in docs_by_id or freq.get(it["answer"], 0) != 1:
                continue
            if only_ids is not None and it["id"] not in only_ids:
                continue
            kind = next((k for k, tok, _ in _literals(it["answer"]) if tok == it["answer"]),
                        None)
            if kind is None:
                continue
            n += 1
            try:
                hits = _post(url, CANDIDATE_PATHS[path],
                             {"query": it["query"], "limit": limit})
            except Exception:
                failures += 1
                n -= 1
                continue
            ids = [(h.get("document", h) or {}).get("id") for h in hits]
            texts = [((h.get("document", h) or {}).get("content") or "") for h in hits]
            if ids and ids[0] == it["id"]:
                rank1 += 1
            try:
                tpos = ids.index(it["id"])
            except ValueError:
                tpos = None
                target_absent += 1

            def _confusable(text):
                return [tok for k, tok, _ in _literals(text)
                        if k == kind and tok != it["answer"]]

            any_conf = False
            above_conf = None
            for i, (hid, txt) in enumerate(zip(ids, texts)):
                if hid == it["id"]:
                    continue
                c = _confusable(txt)
                if not c:
                    continue
                any_conf = True
                if tpos is None or i < tpos:
                    above_conf = above_conf or c[0]
            if any_conf:
                present += 1
            if above_conf:
                above += 1
                if len(examples) < 12:
                    examples.append({"query": it["query"][:110],
                                     "right": it["answer"],
                                     "wrong_ranked_higher": above_conf})

    pct = lambda k: round(100 * k / n, 2) if n else None
    return {"task": "hard_negatives", "path": path, "n": n, "failures": failures,
            "target_rank1_pct": pct(rank1),
            "target_absent_from_topk": target_absent,
            # ⭐ THE HEADLINE: a well-formed WRONG value outranked the right one.
            "confusable_above_target_pct": pct(above),
            # ⛔ THE CONTROL: how often a confusable was even available to win.
            # A low headline is only meaningful if this is not also low.
            "confusable_present_pct": pct(present),
            "examples": examples,
            "control_ok": n > 0 and present > 0,
            "status": "ok" if n > 0 else "could_not_run",
            "why": (None if n == 0 or present > 0 else
                    "NO confusable literals appeared anywhere in top-k — a clean "
                    "headline here says nothing about ranking, only that this "
                    "sample had nothing to confuse the model with")}


# ------------------------------------------------------- task: query replay
def task_query_replay(url: str, path: str, queries: list, limit: int = 10) -> dict:
    """Replay REAL agent queries. [2026-08-09]

    ⭐ Every other task asks a synthetic question. `own_title` searches for a
    document using its own title, which is close to the easiest retrieval task
    that exists. Agents do not do that.

    ⛔ WHAT THIS CAN AND CANNOT MEASURE. There is no ground truth for a real
    query — nobody recorded what the right answer was. So this does NOT score
    correctness, and any number here that looks like accuracy is a mistake.
    What it honestly measures is COVERAGE and COST: did the store return
    anything at all, and how long did it take. The returned top-1 ids are kept
    so two builds can be compared for AGREEMENT, which is also not correctness —
    two builds agreeing can both be wrong.

    ⚠️ Queries are filtered to real MCP traffic by the caller. The log is ~29%
    the benchmark's own requests; grading against those would be the suite
    marking its own homework.
    """
    if not queries:
        return {"task": "query_replay", "path": path, "status": "could_not_run",
                "why": "no real queries available (see --replay-source)",
                "control_ok": False}
    lat, empty, failures, top1 = [], 0, 0, {}
    for q in queries:
        t0 = time.time()
        try:
            hits = _post(url, CANDIDATE_PATHS[path], {"query": q, "limit": limit})
        except Exception:
            failures += 1
            continue
        lat.append(time.time() - t0)
        if not hits:
            empty += 1
        else:
            top1[q] = (hits[0].get("document", hits[0]) or {}).get("id")
    n = len(lat)
    srt = sorted(lat)
    p = lambda f: round(srt[min(int(len(srt) * f), len(srt) - 1)], 3) if srt else None
    return {"task": "query_replay", "path": path, "n": n,
            "requested": len(queries), "failures": failures,
            "returned_nothing": empty,
            "returned_nothing_pct": round(100 * empty / n, 2) if n else None,
            "latency_p50_s": p(0.5), "latency_p95_s": p(0.95),
            "latency_max_s": round(max(lat), 3) if lat else None,
            "top1_by_query": top1,
            # ⛔ Not a correctness control — there is none. This only asserts the
            # replay actually ran against a live path.
            "control_ok": n > 0,
            "status": "ok" if n > 0 else "could_not_run"}


def load_replay_queries(container: str | None, n: int, seed: int) -> list:
    """Pull real MCP queries out of a build's own query_log.

    ⛔ EXCLUDES the benchmark's own traffic. Measured 2026-08-09: of 9,263 logged
    queries, 2,711 carry the suite's user-agent and 3,559 are bare urllib. Only
    `mcp:%` is real agent usage (2,593 rows, 1,687 of them memo_context).
    Replaying our own probes would be the suite grading its own homework.
    """
    if not container:
        return []
    code = (
        "import sqlite3,json;"
        "c=sqlite3.connect('/data/memo.db');"
        "rows=c.execute(\"SELECT DISTINCT query FROM query_log WHERE "
        "user_agent LIKE 'mcp:%' AND query IS NOT NULL AND length(query)>8 "
        "ORDER BY query\").fetchall();"
        "print(json.dumps([r[0] for r in rows]))")
    try:
        r = subprocess.run(["docker", "exec", container, "python3", "-c", code],
                           capture_output=True, text=True, timeout=60)
        qs = json.loads((r.stdout or "[]").strip() or "[]")
    except Exception:
        return []
    # Deterministic subset: same seed -> same queries, so two runs are comparable.
    rnd = random.Random(seed)
    rnd.shuffle(qs)
    return qs[:n]


# ------------------------------------------------------- task: set-stability
def task_set_stability(url: str, path: str, n: int, seed: int,
                       replicates: int = 3) -> dict:
    """T287: is retrieval SET-stable, not merely RANK-stable?

    Measured 2026-08-03: target rank never varied (0/25) while the returned ID
    LIST varied 11/25. ⇒ two identical /recall calls can cite different
    SUPPORTING documents. Whether that is a defect is a REQUIREMENTS question
    and is deliberately not decided here — this only measures it.
    """
    import random
    docs = _get(url, "/documents?limit=20000")
    rng = random.Random(seed)
    sample = rng.sample([d for d in docs if (d.get("title") or "").strip()],
                        min(n, len(docs)))
    rank_var = set_var = ran = 0
    for d in sample:
        seen = []
        for _ in range(replicates):
            try:
                hits = _post(url, CANDIDATE_PATHS[path],
                             {"query": (d.get("title") or "")[:200], "limit": 10})
            except Exception:
                seen = []
                break
            seen.append([(h.get("document", h) or {}).get("id") for h in hits])
        if len(seen) != replicates:
            continue
        ran += 1
        if len({s[0] if s else None for s in seen}) > 1:
            rank_var += 1
        if len({tuple(s) for s in seen}) > 1:
            set_var += 1
    return {"task": "set_stability", "path": path, "n_requested": n, "n_ran": ran,
            "replicates": replicates,
            "rank1_varied": rank_var, "id_list_varied": set_var,
            "control_ok": ran > 0,
            "status": "ok" if ran > 0 else "could_not_run"}


# ------------------------------------------------- task: API surface contract
def task_api_surface(url: str) -> dict:
    """Route inventory + response SHAPE. A cutover breaks on shape, not accuracy.

    Records routes and the observed shape of a search hit so two builds can be
    diffed structurally rather than by eyeballing one response each.
    """
    out = {"task": "api_surface", "routes": None, "search_shape": {}}
    try:
        spec = _get(url, "/openapi.json", timeout=30)
        out["routes"] = sorted(spec.get("paths", {}).keys())
    except Exception as e:
        out["routes_error"] = str(e)
    for label, p in CANDIDATE_PATHS.items():
        try:
            hits = _post(url, p, {"query": "barn cluster node inventory", "limit": 2})
        except Exception as e:
            out["search_shape"][label] = {"error": type(e).__name__}
            continue
        row = hits[0] if isinstance(hits, list) and hits else None
        out["search_shape"][label] = {
            "container": type(hits).__name__,
            "row_keys": sorted(row.keys()) if isinstance(row, dict) else None,
            "doc_keys": sorted((row.get("document") or {}).keys())
            if isinstance(row, dict) and isinstance(row.get("document"), dict) else None,
        }
    out["control_ok"] = bool(out.get("routes"))
    out["status"] = "ok" if out["control_ok"] else "could_not_run"
    return out


# ------------------------------------------------------------- sample minting
def mint_sample(path: Path, url: str, per_band: int, seed: int,
                stamp: str, check_url: str | None = None) -> int:
    """Draw one stratified sample and freeze it as the question set.

    ⭐ **Mint from the corpus the builds are SYNCED TO, not from a candidate.**
    Minting from v2 would pin questions about the 88 documents v2 holds and v1
    does not, and every one of them would score `missing` on v1 — an artefact of
    where the sample came from, reported as a property of v1.

    ⚠️ Re-minting resets the baseline. Every stored result names the sample it
    used (`run.sample.id`); `memo-qa-diff` refuses to subtract across two ids.

    ⭐ **EXTENDING IS ADDITIVE-ONLY, AND THAT IS ENFORCED HERE RATHER THAN ASKED
    FOR IN A COMMENT.** A new task needs questions minted for it, but re-drawing
    the EXISTING tasks would change them silently: v1 is live and takes writes, so
    the same seed over tomorrow's corpus draws a different sample (that is R-17).
    Two runs would then carry the same `sample_id` and different questions — the
    exact failure the id exists to prevent. So an extend adds tasks the file does
    not have, never touches the ones it does, and refuses if asked to.
    ⇒ `sample_id` means "these questions", and stays valid for every task both
    runs actually ran. A task absent from the sample is `could_not_run`, and a
    missing task is never a zero.
    """
    docs = _get(url, "/documents?limit=20000")
    if not docs:
        print(f"✗ {url} returned no documents — refusing to mint an empty sample",
              file=sys.stderr)
        return 1
    existing = None
    if path.exists():
        existing = json.loads(path.read_text())
        print(f"extending {path} ({existing.get('sample_id')}) — existing tasks "
              f"are NOT redrawn: {', '.join(sorted(existing.get('tasks') or {}))}")
    if existing:
        out = existing
        out.setdefault("revisions", [{"rev": 1, "created_utc":
                                      out.get("created_utc"), "added":
                                      sorted(out.get("tasks") or {})}])
    else:
        out = {"schema": 2, "sample_id": f"s-{stamp}", "created_utc": stamp,
               "minted_from": {"url": url, "corpus_n": len(docs)},
               "git": git_state(), "seed": seed, "per_band": per_band,
               "tasks": {}, "revisions": []}
    added = []
    for task in ("own_title", "content_query", "answer_recall"):
        if task in out["tasks"]:
            print(f"  {task}: kept as-is "
                  f"({sum(len(b['items']) for b in out['tasks'][task]['bands'])} "
                  f"questions)")
            continue
        bands = _draw_bands(docs, task, per_band, seed)
        out["tasks"][task] = {"bands": bands, "minted_utc": stamp,
                              "minted_from": {"url": url, "corpus_n": len(docs)}}
        added.append(task)
        if task == "answer_recall" and check_url:
            # ⛔ A question must be gradeable on EVERY build it will be scored on,
            # or the builds are scored over different question sets and the totals
            # will not say so. A literal unique in v1 need not be unique in v2 —
            # v2 holds 88 documents v1 does not. Drop those here, ONCE, rather
            # than letting each target drop its own at run time.
            other = _get(check_url, "/documents?limit=20000")
            ofreq = _prepare_answer(other)["freq"]
            dropped = 0
            for b in bands:
                keep = [i for i in b["items"] if ofreq.get(i["answer"], 0) <= 1]
                dropped += len(b["items"]) - len(keep)
                b["items"] = keep
            out["tasks"][task]["uniqueness_checked_against"] = {
                "url": check_url, "corpus_n": len(other), "dropped": dropped}
            print(f"  {task}: dropped {dropped} not-unique-on-{check_url}")
        n = sum(len(b["items"]) for b in bands)
        thin = [b["band"] for b in bands if len(b["items"]) < per_band]
        print(f"  {task}: {n} questions across {len(bands)} bands"
              + (f"  ⚠️ under-filled: {', '.join(thin)}" if thin else ""))
    if existing and not added:
        print("nothing to add — sample unchanged")
        return 0
    if existing:
        out["revisions"].append({"rev": len(out["revisions"]) + 1,
                                 "created_utc": stamp, "added": added})
    # ⛔ A sample whose questions are not unique would score the same document
    # twice and quietly weight it double.
    for task, spec in out["tasks"].items():
        ids = [i["id"] for b in spec["bands"] for i in b["items"]]
        if len(ids) != len(set(ids)):
            print(f"✗ {task}: {len(ids) - len(set(ids))} duplicate ids",
                  file=sys.stderr)
            return 1
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(json.dumps(out, indent=2))
    print(f"\nwrote {path}  (sample_id {out['sample_id']})")
    return 0


# ------------------------------------------------------------------- runner
TASKS = ("own_title", "content_query", "answer_recall", "context_fit",
         "supersession", "hard_negatives", "query_replay", "set_stability",
         "api_surface")

# Tasks worth repeating to establish their OWN noise floor. context_fit and
# query_replay are excluded on cost, api_surface and set_stability because
# neither produces a rate to spread.
REPLICABLE = ("own_title", "content_query", "answer_recall", "supersession",
              "hard_negatives")


def _numeric_pcts(node: dict) -> dict:
    return {k: v for k, v in node.items()
            if k.endswith("_pct") and isinstance(v, (int, float))}


def _spread(runs: list) -> dict:
    """Observed range per metric across replicates of ONE task on ONE path.

    ⭐ WHY PER-METRIC AND NOT ONE GLOBAL FIGURE. This suite has been quoted with
    a single ~2.4pt noise floor applied to everything, and that cannot be right
    for metrics whose n differs by an order of magnitude: `own_title` runs
    n=300, `supersession` n=29. One flip on the latter is 3.4 points — already
    wider than the global figure it was being judged against.

    ⇒ The floor is measured here rather than remembered, and it is reported
    NEXT TO the number it applies to. A delta smaller than its own metric's
    spread is not a result.
    """
    if len(runs) < 2:
        return {}
    keys = set()
    for r in runs:
        keys |= set(_numeric_pcts(r))
    out = {}
    for k in sorted(keys):
        vals = [r[k] for r in runs if isinstance(r.get(k), (int, float))]
        if len(vals) < 2:
            continue
        out[k] = {"min": min(vals), "max": max(vals),
                  "range_pt": round(max(vals) - min(vals), 2)}
    return out


def _run_replicated(fn, replicates: int):
    """Run a task fn `replicates` times; return (primary_result, spread).

    The FIRST run stays the primary so stored results keep one shape and older
    readers keep working. Spread is attached beside it, never folded into it.
    """
    runs = [fn() for _ in range(max(1, replicates))]
    primary = runs[0]
    if len(runs) < 2:
        return primary, None
    # Two result shapes in this suite: a flat dict, or {path: dict}.
    if "task" in primary:
        return primary, {"_": _spread(runs)}
    sp = {}
    for path in primary:
        if path == "elapsed_s":
            continue
        per = [r[path] for r in runs if isinstance(r.get(path), dict)]
        if len(per) >= 2:
            sp[path] = _spread(per)
    return primary, sp


def main() -> int:
    ap = argparse.ArgumentParser(description=__doc__,
                                 formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("--v1-url", default="http://server4:8000")
    ap.add_argument("--v2-url", default="http://localhost:8091")
    # ⛔ THE SLOTS ARE STRUCTURAL; THE NAMES ARE NOT. Nothing stops --v1-url
    # pointing at a second v2 build — which is the right way to isolate one
    # variable, and is also EXACTLY how R-14 came to call a v2 build "the
    # incumbent" and conclude the cutover lost. The slot keys stay v1/v2 so
    # stored results keep one shape; what a reader SEES is set here.
    ap.add_argument("--v1-name", default=None,
                    help="honest display name for the --v1-url build "
                         "(e.g. 'v2@3-large'). Defaults to the slot key.")
    ap.add_argument("--v2-name", default=None)
    ap.add_argument("--v1-container", default="memo")
    ap.add_argument("--v2-container", default="memo-v2")
    ap.add_argument("--per-band", type=int, default=60)
    ap.add_argument("--seed", type=int, default=7)
    ap.add_argument("--stability-n", type=int, default=25)
    ap.add_argument("--edges", default=str(SAMPLES / "supersede-edges.json"),
                    help="supersession edge list (memo-regenerate-supersede-edges --out)")
    ap.add_argument("--probe-timeout", type=float, default=30.0,
                    help="per-path reachability probe budget. Raise it on a "
                         "loaded host: a timeout drops the WHOLE target to "
                         "could_not_run, so slow reads as gone.")
    ap.add_argument("--token-budget", type=int, default=4000,
                    help="/context budget for answer_recall (both builds default "
                         "to 4000; changing it changes what is being measured)")
    ap.add_argument("--tasks", default=",".join(TASKS))
    ap.add_argument("--replicates", type=int, default=1,
                    help="repeat each replicable task N times and record the "
                         "OBSERVED RANGE per metric. N=1 records no spread, so "
                         "any delta you then quote rests on a floor you did not "
                         "measure in this run.")
    ap.add_argument("--replay-n", type=int, default=120,
                    help="real MCP queries to replay (0 disables). Drawn "
                         "deterministically from --seed so runs are comparable.")
    ap.add_argument("--replay-from", default=None,
                    help="container whose query_log supplies real queries "
                         "(default: --v1-container, the corpus both are synced to)")
    ap.add_argument("--no-common-denominator", action="store_true",
                    help="score each target over whatever IT can grade. ⛔ Then "
                         "the percentages rest on different question sets.")
    ap.add_argument("--label", default="", help="free-text note stored with the run")
    ap.add_argument("--out", default=None)
    ap.add_argument("--sample", default=str(SAMPLES / "default.json"),
                    help="pinned question file (see --mint-sample). "
                         "Pass 'none' to draw fresh — NOT comparable across runs.")
    ap.add_argument("--mint-sample", metavar="PATH", default=None,
                    help="draw a fresh stratified sample from --mint-from and "
                         "write it as a pinned question file, then exit")
    ap.add_argument("--mint-check", default=None,
                    help="second corpus answer literals must ALSO be unique in "
                         "(default: --v2-url). Pass 'none' to skip.")
    ap.add_argument("--mint-from", default=None,
                    help="corpus to mint from (default: --v1-url, the corpus both "
                         "builds are synced to)")
    args = ap.parse_args()

    stamp = datetime.now(timezone.utc).strftime("%Y-%m-%dT%H%M%SZ")

    if args.mint_sample:
        return mint_sample(Path(args.mint_sample), args.mint_from or args.v1_url,
                           args.per_band, args.seed, stamp,
                           check_url=(None if (args.mint_check or '').lower()=='none'
                                      else (args.mint_check or args.v2_url)))

    sample = None
    if args.sample and args.sample.lower() != "none":
        p = Path(args.sample)
        if p.exists():
            sample = json.loads(p.read_text())
            print(f"pinned sample: {p} ({sample.get('sample_id')})", flush=True)
        else:
            # ⛔ Do not silently fall back to drawing. A drawn run and a pinned run
            # look identical in the results file except for one null field, and
            # the whole point of R-17 is that the difference is invisible in the
            # NUMBERS. Say it here, loudly, at the moment it becomes true.
            print(f"⚠️  no pinned sample at {p} — DRAWING FRESH. This run is "
                  f"reproducible but NOT comparable to any other run.\n"
                  f"    Mint one:  {Path(__file__).name} --mint-sample {p}",
                  file=sys.stderr, flush=True)

    want = [t.strip() for t in args.tasks.split(",") if t.strip()]
    run = {"schema": 2, "run_id": stamp, "label": args.label,
           "git": git_state(), "seed": args.seed, "per_band": args.per_band,
           "sample": ({"id": sample.get("sample_id"), "path": args.sample,
                       "minted_from": sample.get("minted_from")}
                      if sample else None),
           "targets": [], "results": {}}

    targets = [("v1", args.v1_url, args.v1_container),
               ("v2", args.v2_url, args.v2_container)]
    display = {"v1": args.v1_name or "v1", "v2": args.v2_name or "v2"}
    run["display_names"] = display
    run["probe_timeout_s"] = args.probe_timeout
    for name, url, cont in targets:
        t = resolve_target(name, url, cont, probe_timeout=args.probe_timeout)
        t["display_name"] = display[name]
        if t["reachable"]:
            try:
                t["corpus"] = corpus(url)
            except Exception as e:
                t["corpus"] = {"error": str(e)}
        run["targets"].append(t)
        print(f"{display[name]} [slot {name}]: reachable={t['reachable']} "
              f"resolved={t.get('resolved')}", flush=True)
        print(f"    paths={t['search_paths']}", flush=True)

    # ⭐ COMMON DENOMINATOR, computed BEFORE any query runs. Each target reports
    # which pinned answer_recall items IT can grade; the intersection is what
    # every target is then scored on. Cheap — one corpus read per target, no
    # searches. See _gradeable_answer_ids for the bug this closes.
    common_ids = None
    if not args.no_common_denominator and sample is not None:
        per_target, reach = {}, [t for t in run["targets"] if t["reachable"]]
        for t in reach:
            try:
                per_target[t["name"]] = _gradeable_answer_ids(t["url"], sample)
            except Exception as e:
                print(f"⚠️  gradeability pre-pass failed for {t['name']}: "
                      f"{type(e).__name__}: {e} — scoring WITHOUT a common "
                      f"denominator", file=sys.stderr, flush=True)
                per_target = {}
                break
        if len(per_target) >= 2:
            common_ids = set.intersection(*per_target.values())
            run["common_denominator"] = {
                "n": len(common_ids),
                "per_target_gradeable": {k: len(v) for k, v in per_target.items()},
                "dropped_to_align": {k: len(v) - len(common_ids)
                                     for k, v in per_target.items()},
            }
            print(f"common denominator: {len(common_ids)} answer items gradeable "
                  f"on every target "
                  f"({ {k: len(v) for k, v in per_target.items()} } individually)",
                  flush=True)

    replay_container = args.replay_from or args.v1_container
    replay_queries = (load_replay_queries(replay_container, args.replay_n, args.seed)
                      if args.replay_n else [])
    run["replay"] = {"requested": args.replay_n, "loaded": len(replay_queries),
                     "from_container": replay_container}
    if args.replay_n and not replay_queries:
        print(f"⚠️  no real queries loaded from {replay_container} — query_replay "
              f"will report could_not_run rather than a score of zero",
              file=sys.stderr, flush=True)
    else:
        print(f"replay: {len(replay_queries)} real MCP queries from {replay_container}",
              flush=True)
    run["replicates"] = args.replicates

    for name, url, _ in targets:
        tgt = next(t for t in run["targets"] if t["name"] == name)
        if not tgt["reachable"]:
            run["results"][name] = {"status": "could_not_run",
                                    "why": "service unreachable"}
            continue
        # Pick the search path this build actually exposes, and RECORD it.
        paths = [p for p, v in tgt["search_paths"].items() if v == "present"]
        primary = ("document" if "document" in paths
                   else "v1-search" if "v1-search" in paths
                   else (paths[0] if paths else None))
        if primary is None:
            run["results"][name] = {"status": "could_not_run",
                                    "why": "no working search path"}
            continue
        res = {"primary_path": primary, "paths_present": paths}
        for task in want:
            print(f"  [{name}] {task} …", flush=True)
            t0 = time.time()
            reps = args.replicates if task in REPLICABLE else 1
            try:
                if task == "own_title":
                    fn = lambda: {p: task_own_title(url, p, args.per_band,
                                                    args.seed, sample)
                                  for p in paths}
                elif task == "content_query":
                    fn = lambda: {p: task_content_query(url, p, args.per_band,
                                                        args.seed, sample)
                                  for p in paths}
                elif task == "answer_recall":
                    fn = lambda: {p: task_answer_recall(url, p, args.per_band,
                                                        args.seed, sample,
                                                        only_ids=common_ids)
                                  for p in paths}
                elif task == "context_fit":
                    fn = lambda: task_context_fit(url, args.per_band, args.seed,
                                                  sample, budget=args.token_budget)
                elif task == "supersession":
                    fn = lambda: {p: task_supersession(url, p, args.edges)
                                  for p in paths}
                elif task == "hard_negatives":
                    fn = lambda: {p: task_hard_negatives(url, p, sample,
                                                         only_ids=common_ids)
                                  for p in paths}
                elif task == "query_replay":
                    fn = lambda: {p: task_query_replay(url, p, replay_queries)
                                  for p in paths}
                elif task == "set_stability":
                    fn = lambda: task_set_stability(url, primary,
                                                    args.stability_n, args.seed)
                elif task == "api_surface":
                    fn = lambda: task_api_surface(url)
                else:
                    fn = lambda: {"status": "could_not_run",
                                  "why": f"unknown task {task}"}
                r, spread = _run_replicated(fn, reps)
            except Exception as e:
                r, spread = {"status": "could_not_run",
                             "why": f"{type(e).__name__}: {e}"}, None
            if isinstance(r, dict):
                r["elapsed_s"] = round(time.time() - t0, 1)
                if reps > 1:
                    r["replicates"] = reps
                if spread:
                    # ⛔ Beside the numbers, never folded into them.
                    r["observed_spread"] = spread
            res[task] = r
        run["results"][name] = res

    RESULTS.mkdir(parents=True, exist_ok=True)
    out = Path(args.out) if args.out else RESULTS / f"qa-{stamp}.json"
    out.write_text(json.dumps(run, indent=2))
    print(f"\nwrote {out}")

    for name in ("v1", "v2"):
        r = run["results"].get(name, {})
        ar = r.get("answer_recall") or {}
        for path, v in (ar.items() if isinstance(ar, dict)
                        and "task" not in ar else []):
            if isinstance(v, dict) and v.get("status") == "ok":
                print(f"  {name:3} answer_recall  {path:10} "
                      f"right-doc {v['right_doc_top1_pct']}% · "
                      f"ANSWER in span {v['answer_in_topk_pct']}% / "
                      f"in full doc {v['answer_in_topk_fulldoc_pct']}% "
                      f"(span costs {v['span_cost_pt']}pt)"
                      + (f" · {v['total_ambiguous']} ungradeable"
                         if v.get("total_ambiguous") else ""))
        sup = r.get("supersession") or {}
        for path, v in (sup.items() if isinstance(sup, dict)
                        and "task" not in sup else []):
            if isinstance(v, dict) and v.get("status") == "ok":
                # ⚠️ n ON THE SAME LINE. It is n=29, so ONE flip is 3.4pt —
                # wider than the ~2.4pt floor this suite gets quoted with. A
                # rate whose denominator is only in the JSON gets compared as if
                # it had the same resolution as the n=300 tasks.
                print(f"  {name:3} supersession   {path:10} "
                      f"replacement @1 {v['replacement_at_1_pct']}% · "
                      f"top5 {v['replacement_in_top5_pct']}% · "
                      f"NEITHER returned {v['neither_returned_pct']}% · "
                      f"old still returned {v['superseded_still_returned']} "
                      f"(n={v.get('n_ran')}, 1 flip = "
                      f"{round(100 / v['n_ran'], 1) if v.get('n_ran') else '?'}pt)"
                      + ("  ⛔ FR-115 NOT FILTERING"
                         if v['superseded_still_returned'] else ""))
        hn = r.get("hard_negatives") or {}
        for path, v in (hn.items() if isinstance(hn, dict)
                        and "task" not in hn else []):
            if isinstance(v, dict) and v.get("status") == "ok":
                ctl = ("" if v.get("control_ok") else
                       "  ⛔ NO CONFUSABLES PRESENT — headline says nothing")
                print(f"  {name:3} hard_negatives {path:10} "
                      f"WRONG value outranked right "
                      f"{v['confusable_above_target_pct']}% · "
                      f"confusable present {v['confusable_present_pct']}% "
                      f"(control) · target rank-1 {v['target_rank1_pct']}% "
                      f"(n={v['n']}){ctl}")
        qr = r.get("query_replay") or {}
        for path, v in (qr.items() if isinstance(qr, dict)
                        and "task" not in qr else []):
            if isinstance(v, dict) and v.get("status") == "ok":
                print(f"  {name:3} query_replay   {path:10} "
                      f"n={v['n']} real queries · returned nothing "
                      f"{v['returned_nothing_pct']}% · "
                      f"p50 {v['latency_p50_s']}s · p95 {v['latency_p95_s']}s "
                      f"· max {v['latency_max_s']}s  "
                      f"⚠️ coverage+cost only, NOT correctness")
        cf = r.get("context_fit")
        if isinstance(cf, dict) and cf.get("status") == "ok":
            print(f"  {name:3} context_fit                answer in /context "
                  f"{cf['answer_in_context_pct']}% · {cf['context_tokens_mean']} "
                  f"tok ({cf['budget_used_pct']}% of budget) · "
                  f"{cf['context_docs_mean']} docs, "
                  f"{cf['server_duplicates_dropped_mean']} deduped/call · "
                  f"⭐ {cf['tokens_per_answer_delivered']} tok/ANSWER · "
                  f"truncated {cf['truncated_pct']}%")
        for task in ("own_title", "content_query"):
            tr = r.get(task) or {}
            for path, v in (tr.items() if isinstance(tr, dict)
                            and "task" not in tr else []):
                if not (isinstance(v, dict) and v.get("status") == "ok"):
                    continue
                # ⚠️ `missing` is printed on the SAME line as the score, not in a
                # footnote — a score computed over a shrunken denominator must not
                # be readable without the denominator that produced it.
                miss = v.get("total_missing") or 0
                print(f"  {name:3} {task:14} {path:10} unweighted rank-1 "
                      f"{v['unweighted_rank1_pct']}%  "
                      f"({v['total_rank1']}/{v['total_n']}, "
                      f"{v['total_failures']} query failures"
                      + (f", ⚠️ {miss} pinned ids NOT IN THIS CORPUS" if miss else "")
                      + ")")

    # ⭐ MEASURED NOISE FLOORS, PER METRIC. Printed as its own block because a
    # delta smaller than its metric's own observed range is not a finding, and
    # that comparison has to be cheap to make.
    any_spread = False
    for name in ("v1", "v2"):
        for task, node in (run["results"].get(name) or {}).items():
            if not isinstance(node, dict):
                continue
            sp = node.get("observed_spread") or {}
            for path, metrics in sp.items():
                for metric, s in (metrics or {}).items():
                    if s.get("range_pt", 0) > 0:
                        any_spread = True
                        print(f"  ~   NOISE {name:3} {task:14} {path:10} "
                              f"{metric}: ±{s['range_pt']}pt observed "
                              f"({s['min']}–{s['max']} over "
                              f"{node.get('replicates')} runs)")
    if run.get("replicates", 1) > 1 and not any_spread:
        print(f"  ~   NOISE: every replicated metric was IDENTICAL across "
              f"{run['replicates']} runs — floor below reporting resolution")
    elif run.get("replicates", 1) == 1:
        print("  ~   NOISE: --replicates 1, so NO floor was measured this run. "
              "Any delta quoted from it rests on an assumed one.")

    # ⭐ COST, alongside quality. v2 ran 2.4x slower than v1 on 2026-08-09 and
    # the summary did not say so — retrieval quality without its cost is half of
    # the decision this suite exists to inform.
    print()
    for name in ("v1", "v2"):
        r = run["results"].get(name) or {}
        per = {t: n.get("elapsed_s") for t, n in r.items()
               if isinstance(n, dict) and n.get("elapsed_s") is not None}
        if not per:
            continue
        total = round(sum(per.values()), 1)
        slowest = max(per, key=per.get)
        print(f"  {name:3} ELAPSED total {total}s · slowest {slowest} "
              f"{per[slowest]}s · " +
              " ".join(f"{t}={v}s" for t, v in sorted(per.items(),
                                                      key=lambda kv: -kv[1])[:4]))
    cd = run.get("common_denominator")
    if cd:
        print(f"\n  answer_recall scored over {cd['n']} items common to every "
              f"target; dropped to align: {cd['dropped_to_align']}")
    return 0


if __name__ == "__main__":
    sys.exit(main())
