#!/usr/bin/env python3
"""memo-verify-provenance — MEASURE which model wrote the vectors. [002/FR-108]

Do not trust `document_chunks.embedding_model`. Measure.

**Why, concretely.** On 2026-08-02 that column read
`openai/text-embedding-3-large` for all 19,554 chunks whose vectors had actually
been written by `qwen3-embedding-4b` — the re-embed wrote the vector tables
directly and never updated the provenance. The field was present and LYING, which
is strictly worse than absent because every future reader, and every check built
on it, would trust it.

**A declared provenance column cannot check itself.** It is written by the same
code path that writes the vectors, so it inherits that path's bugs and fails in
the direction that looks fine. This uses a DIFFERENT generator: re-embed the
stored source text with the currently configured model and compare to the vector
on disk.

    cosine ~1.0  → the configured model IS the model that wrote this vector
    cosine far   → the record is lying, whatever the column says

⚠️ Threshold is 0.999, not equality, and NOT a hash. Embedding endpoints are
mildly nondeterministic under load — a real chunk measured 0.999916 while three
migrations shared the GPU — and a hash comparison would flag that as a mismatch
it isn't. Validate under load, not on an idle box. (Technique from the
`embeddings` seat's endpoint identity canary, pointed at a corpus instead.)

⚠️ **WHAT THE THRESHOLD ACTUALLY HAS TO CLEAR — MEASURED HERE, 2026-08-02.**
Run `memo-calibrate-drift` for the current figures; as of 03:10 EDT that day, on
this corpus against this endpoint (worst across 3 rounds × 16 chunks, under GPU
contention):

    singleton vs stored   1.18e-04
    batch-16  vs stored   1.15e-04
    singleton vs batch-16 1.18e-04

**0.999 clears the worst by 8.5×.** Four of the sixteen chunks differ from stored
in every round at byte-identical values, singleton and batched alike — the
endpoint does not reproduce today what it wrote for those chunks. That is the
component this threshold really has to survive.

⚠️ **Do not read one round.** Round 1 alone showed singleton-vs-batch at exactly
1.0 on 15 of 16 rows and would have supported "call shape contributes nothing";
round 2 refuted it. Which rows move is partly a lottery, so a single run of this
measurement can land anywhere from 0.000000 to ~1.7e-04.

⛔ **An earlier version of this comment claimed batch composition contributed
~1.2e-3 and that 0.999 had to absorb it. That figure was measured on
OpenRouter/text-embedding-3-large — a different inference stack — and is ~14×
larger than anything this endpoint produces.** I imported another service's
constant and wrote it here as though it described ours. It does not. (The
conclusion below was unaffected; only the stated reason was wrong.)

⇒ **The consequence that outlives the correction:** the floor is set by how much
the serving environment has changed since the vectors were written, and that grows
on its own with no event to mark it. Re-run `memo-calibrate-drift` after any GPU,
driver, or serving change — an eroding margin produces no symptom until it
produces a false PROVENANCE MISMATCH on a healthy corpus.

Singleton re-embedding is the deliberate choice, for two reasons:
  - it is the WORST-CASE composition mismatch against a batched writer, so a pass
    is conservative rather than flattering;
  - it removes the pairing hazard entirely. A batched verifier must sort by
    `.index` and verify contiguity, because a short or reordered response
    compares vectors to the WRONG CHUNKS and manufactures a provenance failure
    out of its own plumbing. Given how many real instances turned up on
    2026-08-02, a false one would be believed. A verification tool that can
    false-alarm from its own plumbing is worse than none.

The cost is that samples run serially: ~4–8 min at n=100 under contention, versus
~96s batched. That is an acceptable price for a weekly sweep, and it buys a
comparison whose only moving part is the model.

    docker compose exec -T memo-v2 python /app/scripts/memo-verify-provenance
"""
from __future__ import annotations

import argparse
import asyncio
import math
import struct
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parents[1] / "src"))
sys.path.insert(0, "/app/src")

from memo import db, embeddings  # noqa: E402
from memo.config import settings  # noqa: E402

THRESHOLD = 0.999


def _cosine(a, b) -> float:
    dot = sum(x * y for x, y in zip(a, b))
    na = math.sqrt(sum(x * x for x in a))
    nb = math.sqrt(sum(y * y for y in b))
    return dot / (na * nb) if na and nb else 0.0


async def main() -> int:
    ap = argparse.ArgumentParser(description=__doc__,
                                 formatter_class=argparse.RawDescriptionHelpFormatter)
    # Default 100: with stride sampling, n is the GUARANTEE, not a confidence
    # level — n ≥ 1/x deterministically catches any contiguous block of fraction
    # x. n=100 → ~1%. That is ~100 embeddings, which is nothing for a weekly
    # sweep. Drop it for a quick ad-hoc check, but read the detection limit the
    # run prints rather than assuming a small n means much.
    ap.add_argument("--sample", type=int, default=100)
    ap.add_argument("--threshold", type=float, default=THRESHOLD)
    args = ap.parse_args()

    conn = db._get_or_create_conn(db.global_path())
    declared = conn.execute(
        "SELECT DISTINCT embedding_model FROM document_chunks").fetchall()
    print(f"configured : {settings.embedding_model} @ {settings.embedding_dimensions}")
    print(f"declared   : {[d[0] for d in declared]}")

    # STRATIFIED BY WRITE TIME, not uniform random. [refinement from `embeddings`]
    #
    # Uniform sampling implicitly assumes corruption is scattered. The realistic
    # failure here is an interrupted or reconfigured run, which is CONTIGUOUS in
    # `created_at` — so spreading the draws across the write-time range finds it
    # with far fewer samples than random does.
    #
    # The arithmetic that makes this matter for a RECURRING check: to catch a 1%
    # divergence at 95% confidence, uniform sampling needs n ≈ ln(0.05)/ln(0.99)
    # ≈ 300. At n=6 the probability of missing it is 0.99^6 ≈ 94%, so a weekly
    # sweep would report `ok` every Monday against a bad 1% indefinitely. Six
    # random samples prove the corpus is not WHOLESALE in the wrong space; they
    # say almost nothing about a PARTIAL divergence.
    rows = conn.execute(
        "SELECT doc_id, chunk_index, text FROM document_chunks "
        "ORDER BY created_at").fetchall()
    if not rows:
        print("no passages indexed — nothing to verify", flush=True)
        return 0
    total = len(rows)
    step = max(1, total // max(1, args.sample))
    rows = rows[::step][:args.sample]

    # STATE THE DETECTION LIMIT. The stride IS the bound, and unlike a confidence
    # level it is exact: any contiguous block of at least `step` rows is caught
    # deterministically, and a shorter one is missed ENTIRELY — not merely
    # probably. Printing n without printing the stride invites reading a small
    # sample as broad coverage.
    print(f"sampled    : {len(rows)} of {total} chunks, stride {step} "
          f"(stratified by created_at)")
    print(f"detects    : any contiguous block ≥ {step} rows "
          f"(≥ {100 * step / max(1, total):.2f}% of the corpus), deterministically")
    print("blind spot : SCATTERED corruption. Stride sampling assumes the "
          "realistic failure — an interrupted or reconfigured run — is contiguous "
          "in write time. If that assumption is ever wrong here, this is WEAKER "
          "than uniform random sampling, not stronger.")

    worst = 1.0
    checked = 0
    for doc_id, idx, text in rows:
        blob = conn.execute(
            "SELECT embedding FROM chunk_embeddings WHERE doc_id=? AND chunk_index=?",
            (doc_id, idx)).fetchone()
        if not blob:
            print(f"  {doc_id[:8]}#{idx}: chunk row with NO vector — index is "
                  f"inconsistent", file=sys.stderr)
            return 2
        stored = struct.unpack(f"{len(blob[0]) // 4}f", blob[0])
        fresh = await embeddings.embed(text)
        if len(stored) != len(fresh):
            print(f"  {doc_id[:8]}#{idx}: width {len(stored)} stored vs "
                  f"{len(fresh)} fresh", file=sys.stderr)
            return 2
        c = _cosine(stored, fresh)
        worst = min(worst, c)
        checked += 1
        print(f"  {doc_id[:8]}#{idx}  cosine={c:.6f}")

    # NEGATIVE CONTROL. Without it, six passes prove nothing: a comparison that
    # returns ~1.0 to everything produces six identical ticks and reads as proof.
    # This pairs one chunk's stored vector against a DIFFERENT chunk's text, which
    # must score far below threshold. If it does not, the instrument is broken and
    # every pass above is meaningless. (`groton` measured 0.1230 on theirs; the
    # concrete value matters less than that it is nowhere near 1.0.)
    if len(rows) >= 2:
        blob = conn.execute(
            "SELECT embedding FROM chunk_embeddings WHERE doc_id=? AND chunk_index=?",
            (rows[0][0], rows[0][1])).fetchone()
        stored_a = struct.unpack(f"{len(blob[0]) // 4}f", blob[0])
        fresh_b = await embeddings.embed(rows[-1][2])
        control = _cosine(stored_a, fresh_b)
        print(f"\nnegative control (mismatched pair): cosine={control:.4f}")
        if control >= args.threshold:
            print("NEGATIVE CONTROL FAILED — the comparison returns ~1.0 to "
                  "unrelated text, so every pass above is meaningless. The "
                  "instrument is broken, not the corpus.", file=sys.stderr)
            return 2

    print(f"\nchecked {checked}, worst cosine {worst:.6f}, threshold {args.threshold}")
    if worst < args.threshold:
        print("PROVENANCE MISMATCH — the stored vectors were NOT written by the "
              "configured model, whatever `embedding_model` claims. Do not build "
              "a model-identity check on that column until this is resolved.",
              file=sys.stderr)
        return 2
    print("provenance VERIFIED by measurement (not by the declared column)")
    return 0


if __name__ == "__main__":
    rc = asyncio.run(main())
    print(f"EXIT={rc}", flush=True)
    raise SystemExit(rc)
