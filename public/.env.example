# memo-public-mcp secrets — copy to .env, fill in, chmod 600
MCP_HOST=0.0.0.0
MCP_PORT=8901
OAUTH_ISSUER_URL=https://memo.pushbuild.com
OAUTH_RESOURCE_URL=https://memo.pushbuild.com
MEMO_BACKEND_MCP=http://192.168.1.168:8000/mcp/

# Per-user login secrets. Each ENV var matching the pattern <NAME>_LOGIN_SECRET
# is an allowed passphrase; the lowercased <NAME> is the user label baked into
# token audit logs. Add a user by appending a new line + restarting the service.
# Revoke a user by removing/rotating their line + restarting.
LAURA_WORK_LOGIN_SECRET=<openssl rand -base64 24 | tr -d '+/=' | head -c 32>
LAURA_PERSONAL_LOGIN_SECRET=<openssl rand -base64 24 | tr -d '+/=' | head -c 32>
BEN_LOGIN_SECRET=<openssl rand -base64 24 | tr -d '+/=' | head -c 32>
